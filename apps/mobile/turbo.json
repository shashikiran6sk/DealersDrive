{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": ["dist/**"],
      "env": [
        "EXPO_PUBLIC_APP_ENV",
        "EXPO_PUBLIC_API_BASE_URL",
        "EXPO_PUBLIC_WEB_BASE_URL",
        "EXPO_NO_TELEMETRY",
        "APP_ANDROID_PACKAGE",
        "APP_ANDROID_VERSION_CODE",
        "APP_LINK_HOST",
        "APP_RELEASE_APPROVED"
      ],
      "inputs": ["$TURBO_DEFAULT$", "!tests/**"]
    },
    "typecheck": {
      "inputs": ["$TURBO_DEFAULT$"]
    }
  }
}
