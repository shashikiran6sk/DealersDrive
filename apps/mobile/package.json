{
  "name": "@dealers-drive/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "build": "expo export --platform android --source-maps && node scripts/check-bundle.mjs",
    "lint": "eslint . && node scripts/check-boundaries.mjs",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand && node scripts/brand-assets.mjs --check",
    "check:expo": "expo install --check",
    "brand:generate": "node scripts/brand-assets.mjs",
    "brand:check": "node scripts/brand-assets.mjs --check",
    "check:bundle": "node scripts/check-bundle.mjs"
  },
  "dependencies": {
    "@dealers-drive/contracts": "workspace:*",
    "@expo/log-box": "57.0.4",
    "@expo/metro-runtime": "57.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "5.104.3",
    "expo": "57.0.29",
    "expo-constants": "57.0.22",
    "expo-crypto": "57.0.4",
    "expo-dev-client": "57.0.20",
    "expo-font": "57.0.4",
    "expo-image": "57.0.5",
    "expo-linking": "57.0.13",
    "expo-router": "57.0.27",
    "expo-secure-store": "57.0.4",
    "expo-splash-screen": "57.0.10",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "0.21.4",
    "react-native-worklets": "0.13.0",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@dealers-drive/config": "workspace:*",
    "@react-native/jest-preset": "0.88.0",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "29.5.14",
    "@types/node": "24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "jest": "29.7.0",
    "jest-expo": "57.0.6",
    "test-renderer": "1.3.1",
    "typescript": "6.0.3"
  }
}
