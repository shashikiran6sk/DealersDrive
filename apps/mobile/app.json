{
  "expo": {
    "name": "Dealers-Drive",
    "slug": "dealers-drive-customer",
    "version": "0.1.0",
    "scheme": "dealersdrive",
    "platforms": ["android"],
    "userInterfaceStyle": "light",
    "icon": "./src/assets/brand/launcher.png",
    "android": {
      "package": "com.dealersdrive.customer.dev",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/brand/adaptive-foreground.png",
        "monochromeImage": "./src/assets/brand/adaptive-foreground.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_CONTACTS",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_SMS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "allowBackup": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/brand/splash-symbol.png",
          "imageWidth": 96,
          "backgroundColor": "#ffffff"
        }
      ],
      "./config/with-native-theme.cjs",
      "./config/with-retained-intent.cjs"
    ],
    "primaryColor": "#171716"
  }
}
