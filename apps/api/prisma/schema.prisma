// Dealers-Drive — database schema.
// Transcribed from ARCHITECTURE.md §6 (revision r2). Money is BigInt paise
// everywhere; every dealer-owned table carries `dealerId` as a first-class
// column so tenant filtering is one indexed predicate and never a join (§7).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────── IDENTITY (dealers and admins only — no buyer accounts) ──────
model User {
  id              String     @id @default(uuid()) @db.Uuid
  fullName        String?
  roleTitle       String?
  email           String?    @unique
  /// Optional until onboarding collects it: a dealer arrives from Google with a
  /// verified email and nothing else, and an unverified placeholder must never
  /// occupy the unique index (ARCHITECTURE §8.1).
  phone           String?    @unique
  passwordHash    String? // ADMINS ONLY. Dealers sign in with Google.
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  status          UserStatus @default(ACTIVE)
  isPlatformAdmin Boolean    @default(false)
  adminRole       AdminRole?
  totpSecret      String?
  totpEnabledAt   DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())

  sessions    Session[]
  memberships DealerMember[]
  identities  OAuthIdentity[]

  @@map("users")
}

model Session {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @db.Uuid
  tokenHash String       @unique
  /// A dealer session can never satisfy `requireAdmin`, and an admin session can
  /// never satisfy `requireDealer` — even when one human holds both seats.
  scope     SessionScope @default(DEALER)
  expiresAt DateTime
  revokedAt DateTime?
  ip        String?
  userAgent String?
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

/// A verified third-party identity. Dealers sign in with Google and are found
/// by `provider + providerSubject` — Google's `sub`, which is stable — never by
/// the email, which the account holder can change (ARCHITECTURE §8.1 r3).
model OAuthIdentity {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @db.Uuid
  provider        OAuthProvider
  providerSubject String
  /// The address Google asserted at the last sign-in. Informational: it is
  /// refreshed on every login and is never the thing looked up.
  email           String
  emailVerified   Boolean       @default(false)
  displayName     String?
  pictureUrl      String?
  lastLoginAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("oauth_identities")
}

// ─────────── DEALERS (the tenant) ────────────────────────────────────────
model Dealer {
  id                 String       @id @default(uuid()) @db.Uuid
  slug               String       @unique
  brandName          String
  legalName          String
  gstin              String?
  pan                String?
  about              String?
  tagline            String?
  logoMediaId        String?      @db.Uuid
  coverMediaId       String?      @db.Uuid
  status             DealerStatus @default(DRAFT)
  cityId             String?      @db.Uuid
  addressLine        String?
  pincode            String?
  lat                Float?
  lng                Float?
  contactPhone       String?
  contactEmail       String?
  landline           String?
  workingHours       Json?
  establishedYear    Int?
  specialities       String[]
  /// MIRROR of the newest CreditTransaction.balanceAfter. Never authoritative
  /// on its own — every write path re-reads the ledger under FOR UPDATE (§26.2).
  creditBalance      Int          @default(0)
  creditsHeld        Int          @default(0)
  activeListings     Int          @default(0)
  medianResponseMins Int?
  approvedAt         DateTime?
  suspendedAt        DateTime?
  statusReason       String?
  createdAt          DateTime     @default(now())

  city        City?               @relation(fields: [cityId], references: [id])
  members     DealerMember[]
  vehicles    Vehicle[]
  documents   DealerDocument[]
  listings    Listing[]
  enquiries   Enquiry[]
  ledger      CreditTransaction[]
  orders      Order[]
  payments    Payment[]
  invoices    Invoice[]
  photoReqs   PhotoRequest[]
  viewsDaily  ListingViewDaily[]
  phoneReveal PhoneReveal[]

  @@index([status, cityId])
  @@map("dealers")
}

// ─────────── KYC DOCUMENTS (onboarding step 3) ───────────────────────────
// Private. Stored under a separate prefix with no public delivery route.
model DealerDocument {
  id              String        @id @default(uuid()) @db.Uuid
  dealerId        String        @db.Uuid
  type            DealerDocType
  mediaId         String?       @db.Uuid
  fileName        String?
  status          DocStatus     @default(REQUIRED)
  rejectionReason String?
  reviewedBy      String?       @db.Uuid
  reviewedAt      DateTime?
  createdAt       DateTime      @default(now())

  dealer Dealer @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  @@unique([dealerId, type])
  @@index([status, createdAt])
  @@map("dealer_documents")
}

model DealerMember {
  id          String       @id @default(uuid()) @db.Uuid
  dealerId    String       @db.Uuid
  userId      String       @db.Uuid
  role        DealerRole
  permissions String[]
  status      MemberStatus @default(ACTIVE)

  dealer Dealer @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([dealerId, userId])
  @@index([userId])
  @@map("dealer_members")
}

// ─────────── CATALOG (curated taxonomy — dealers never free-type) ────────
model Make {
  id         String  @id @default(uuid()) @db.Uuid
  slug       String  @unique
  name       String
  logoUrl    String?
  popularity Int     @default(0)

  models   Model[]
  vehicles Vehicle[]

  @@map("makes")
}

model Model {
  id       String   @id @default(uuid()) @db.Uuid
  makeId   String   @db.Uuid
  slug     String
  name     String
  bodyType BodyType
  yearFrom Int
  yearTo   Int?

  make     Make      @relation(fields: [makeId], references: [id], onDelete: Cascade)
  variants Variant[]
  vehicles Vehicle[]

  @@unique([makeId, slug])
  @@map("models")
}

model Variant {
  id           String       @id @default(uuid()) @db.Uuid
  modelId      String       @db.Uuid
  slug         String
  name         String
  fuel         FuelType
  transmission Transmission
  engineCc     Int?
  seats        Int?

  model    Model     @relation(fields: [modelId], references: [id], onDelete: Cascade)
  vehicles Vehicle[]

  @@unique([modelId, slug])
  @@map("variants")
}

model City {
  id       String  @id @default(uuid()) @db.Uuid
  slug     String  @unique
  name     String
  state    String
  lat      Float
  lng      Float
  isActive Boolean @default(true)

  dealers  Dealer[]
  vehicles Vehicle[]

  @@map("cities")
}

model Rto {
  code  String @id
  name  String
  city  String
  state String

  @@index([state])
  @@map("rtos")
}

model Color {
  id        String @id @default(uuid()) @db.Uuid
  slug      String @unique
  name      String
  hex       String
  family    String
  sortOrder Int

  vehicles Vehicle[]

  @@map("colors")
}

/// The 30-day cache of immutable RC facts (ARCHITECTURE §6.3).
///
/// ## Why this is a table and not the CachePort
///
/// Rule 10 says the cache holds counters and a version number, never truth.
/// This is truth — the specs a draft was built from — so it lives in the
/// database that already exists.
///
/// ## Why there is no dealerId
///
/// An RC is a fact about a car, not about a dealership. Two dealers appraising
/// the same trade-in should not both be charged for it, so this table is
/// deliberately cross-tenant and `tenant-isolation.test.ts` documents it as an
/// exception rather than a gap. The cost is a weak timing signal — a cached
/// lookup returns faster — which is acceptable for rows holding no personal
/// data. *Who* looked up what is in the audit log, which is tenant-scoped.
///
/// ## Why the plate is hashed
///
/// Real listings store the plate in `vehicles.regNumberMasked`, so this is not
/// secrecy from ourselves. It is about not accumulating a standalone,
/// queryable register of every plate anyone ever asked about — including the
/// ones that never became a listing.
model RcLookup {
  id       String @id @default(uuid()) @db.Uuid
  /// HMAC-SHA256 of the normalised plate under RC_PLATE_HASH_SECRET.
  regHash  String @unique
  provider String

  /// The PII-free `RcSpecs` as the adapter returned it.
  specs    Json
  /// The resolver's output — catalogue ids and per-field confidence. Cached
  /// alongside so a repeat lookup costs neither a provider call nor a re-match.
  resolved Json
  /// The `RcRecords` from the same call.
  ///
  /// Stored here despite records being short-lived, because a dealer confirms
  /// the basics seconds after looking them up and re-fetching for that would
  /// double the cost of every intake for no new information. It is trusted
  /// only while `fetchedAt` is inside `report.freshnessHours`; past that the
  /// service re-fetches rather than writing a stale report. The 30-day
  /// `expiresAt` governs the specs alone.
  records  Json?

  fetchedAt DateTime @default(now())
  /// Successes live 30 days; a "not found" lives one hour, so a genuinely new
  /// registration is not invisible for a month (`rcLookup.cacheDays`).
  expiresAt DateTime
  /// False for a cached miss. Distinguishes "we asked and there is no RC" from
  /// "we have not asked", which are different answers to the dealer.
  found     Boolean  @default(true)

  @@index([expiresAt])
  @@map("rc_lookups")
}

// ─────────── VEHICLES (the physical asset) ───────────────────────────────
model Vehicle {
  id                 String             @id @default(uuid()) @db.Uuid
  dealerId           String             @db.Uuid
  makeId             String             @db.Uuid
  modelId            String             @db.Uuid
  variantId          String?            @db.Uuid
  year               Int
  pricePaise         BigInt?
  kmDriven           Int?
  fuel               FuelType
  transmission       Transmission
  bodyType           BodyType
  ownerNumber        Int?
  colorId            String?            @db.Uuid
  seats              Int?
  airbags            Int?
  rtoCode            String?
  cityId             String?            @db.Uuid
  regNumberMasked    String?
  insuranceType      InsuranceType?
  insuranceValidTill DateTime?
  priceNegotiable    PriceNegotiability @default(SLIGHTLY)
  description        String?
  features           String[]
  /// DEAD COLUMN. Written nowhere, read nowhere — the `specs` array on
  /// `VehicleDetail` is computed from the columns above in
  /// `search.service.ts`. Kept for now because dropping it during a rolling
  /// deploy would break the previous revision's generated SELECTs; remove it
  /// in a contract-phase migration once this release is fully rolled out.
  specs              Json               @default("{}")
  /// BS4 / BS6. From the RC only — there is no way for a dealer to type it,
  /// and it is materially price-relevant on an Indian used car.
  normsType          String?
  /// When the basics were last confirmed against an RC. A timestamp rather
  /// than a boolean because "verified when?" is the question a dealer
  /// disputing a record actually asks.
  rcVerifiedAt       DateTime?
  status             VehicleStatus      @default(DRAFT)
  primaryMediaId     String?            @db.Uuid
  slug               String?            @unique
  soldPricePaise     BigInt?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?

  dealer    Dealer          @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  make      Make            @relation(fields: [makeId], references: [id])
  model     Model           @relation(fields: [modelId], references: [id])
  variant   Variant?        @relation(fields: [variantId], references: [id])
  color     Color?          @relation(fields: [colorId], references: [id])
  city      City?           @relation(fields: [cityId], references: [id])
  media     VehicleMedia[]
  listings  Listing[]
  enquiries Enquiry[]
  reports   VehicleReport[]

  @@index([dealerId, status, createdAt])
  @@index([modelId, year])
  @@index([cityId, pricePaise])
  /// A partial unique index on (dealerId, regNumberMasked) WHERE deletedAt IS
  /// NULL is added by raw SQL in the rc_lookup migration — Prisma cannot
  /// express a partial index. It is what makes "you already have this car"
  /// a database guarantee rather than a check the application might skip.
  @@map("vehicles")
}

model VehicleMedia {
  vehicleId String @db.Uuid
  mediaId   String @db.Uuid
  position  Int

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([vehicleId, mediaId])
  @@index([vehicleId, position])
  @@map("vehicle_media")
}

/// A point-in-time records check for one vehicle (ARCHITECTURE §6.3).
///
/// ## Append-only, never updated
///
/// Every fetch writes a NEW row. Nothing in the application updates one, and
/// nothing deletes one while the vehicle exists. That is not tidiness — it is
/// the answer to "your page said this car was clear". A published report is a
/// claim we made on a date, and an updated-in-place row cannot reproduce what
/// a buyer actually saw. `@@index([vehicleId, fetchedAt(sort: Desc)])` is what
/// makes "the current one" a cheap read over that history.
///
/// ## What is deliberately absent
///
/// No owner name, no violator or driver name, no mobile number, no place of
/// offence, no chassis or engine number, no lender name. Those are stripped in
/// `attestr.adapter.ts` before the domain ever sees them, and there is no
/// column here to hold them if a later change tried.
model VehicleReport {
  id        String @id @default(uuid()) @db.Uuid
  vehicleId String @db.Uuid
  /// Denormalised for tenant filtering — one indexed predicate, never a join (§7).
  dealerId  String @db.Uuid
  /// Which adapter produced this row. A report is only as good as its source,
  /// and after a provider switch we need to know which rows came from where.
  provider  String

  /// The moment the provider answered. This is the `asOf` a buyer is shown,
  /// and it is the whole of the claim's honesty.
  fetchedAt DateTime @default(now())

  blacklistStatus  BlacklistStatus @default(UNKNOWN)
  blacklistReasons String[]
  /// A state, never a person — "NOC issued to Karnataka".
  nocIssuedTo      String?

  /// False when the state's challan feed returned nothing. Distinct from a
  /// zero count, and rendered as "unavailable" rather than "clear": an absent
  /// feed presented as a clean record is the worst failure this table has.
  challansAvailable       Boolean @default(false)
  challanCount            Int     @default(0)
  challanUnpaidCount      Int     @default(0)
  challanOutstandingPaise BigInt  @default(0)
  /// Itemised challans, PII already stripped. Json rather than a table: they
  /// are read as a block with their parent report and never queried across.
  challans                Json    @default("[]")

  /// Whether a loan is on record. The lender's name is the owner's banking
  /// relationship and is never stored.
  financed Boolean?

  rcStatus      String?
  insuranceUpto DateTime?
  fitnessUpto   DateTime?
  pucUpto       DateTime?
  taxUpto       DateTime?

  /// Set when this row was the one live on a public listing page. Null for
  /// rows only ever seen by the dealer.
  publishedAt DateTime?

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, fetchedAt(sort: Desc)])
  @@index([dealerId, fetchedAt])
  @@map("vehicle_reports")
}

model Media {
  id              String      @id @default(uuid()) @db.Uuid
  dealerId        String?     @db.Uuid
  ownerType       MediaOwner
  storageKey      String      @unique
  mimeType        String
  bytes           Int
  width           Int?
  height          Int?
  blurhash        String?
  variants        Json        @default("{}")
  fileName        String?
  warnings        String[]
  uploadedByAdmin Boolean     @default(false)
  status          MediaStatus @default(PENDING)
  createdAt       DateTime    @default(now())

  vehicles VehicleMedia[]

  @@index([status, createdAt])
  @@map("media")
}

// ─────────── LISTINGS (the publication) ──────────────────────────────────
model Listing {
  id                String        @id @default(uuid()) @db.Uuid
  vehicleId         String        @db.Uuid
  dealerId          String        @db.Uuid
  status            ListingStatus @default(PENDING_REVIEW)
  submittedAt       DateTime      @default(now())
  reviewedAt        DateTime?
  reviewedBy        String?       @db.Uuid
  rejectionReason   String?
  changeRequestNote String?
  approvedAt        DateTime?
  expiresAt         DateTime?
  expiryWarned7d    Boolean       @default(false)
  expiryWarned1d    Boolean       @default(false)
  creditHeld        Boolean       @default(false)
  creditTxnId       String?       @db.Uuid
  renewedFromId     String?       @db.Uuid
  soldAt            DateTime?
  removedAt         DateTime?
  viewCount         Int           @default(0)
  enquiryCount      Int           @default(0)
  revealCount       Int           @default(0)

  vehicle    Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  dealer     Dealer              @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  enquiries  Enquiry[]
  ledgerRows CreditTransaction[]
  viewsDaily ListingViewDaily[]

  @@index([status, submittedAt])
  @@index([dealerId, status])
  @@index([status, expiresAt])
  @@map("listings")
}

// ─────────── VIEW ROLLUP (dashboard "Views this week") ───────────────────
model ListingViewDaily {
  listingId String   @db.Uuid
  dealerId  String   @db.Uuid
  day       DateTime @db.Date
  views     Int      @default(0)
  reveals   Int      @default(0)
  enquiries Int      @default(0)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  dealer  Dealer  @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  @@id([listingId, day])
  @@index([dealerId, day])
  @@map("listing_view_daily")
}

// ─────────── LEADS ───────────────────────────────────────────────────────
model Enquiry {
  id           String        @id @default(uuid()) @db.Uuid
  reference    String        @unique
  vehicleId    String?       @db.Uuid
  listingId    String?       @db.Uuid
  dealerId     String        @db.Uuid
  name         String
  phone        String
  email        String?
  message      String?
  source       EnquirySource
  status       EnquiryStatus @default(NEW)
  contactedAt  DateTime?
  contactedBy  String?       @db.Uuid
  closedAt     DateTime?
  closeReason  String?
  note         String?
  markedSpamAt DateTime?
  ip           String?
  userAgent    String?
  createdAt    DateTime      @default(now())

  dealer  Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  listing Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@index([dealerId, status, createdAt])
  @@index([dealerId, createdAt])
  @@index([vehicleId])
  @@index([phone, vehicleId, createdAt])
  @@map("enquiries")
}

model PhoneReveal {
  id        BigInt   @id @default(autoincrement())
  vehicleId String?  @db.Uuid
  dealerId  String   @db.Uuid
  ip        String
  userAgent String?
  createdAt DateTime @default(now())

  dealer Dealer @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  @@index([dealerId, createdAt])
  @@index([ip, createdAt])
  @@map("phone_reveals")
}

// ─────────── PHOTO SHOOTS ────────────────────────────────────────────────
model PhotoRequest {
  id            String             @id @default(uuid()) @db.Uuid
  dealerId      String             @db.Uuid
  vehicleId     String?            @db.Uuid
  vehicleCount  Int                @default(1)
  status        PhotoRequestStatus @default(REQUESTED)
  address       String
  contactName   String
  contactPhone  String
  preferredDate DateTime?
  scheduledFor  DateTime?
  notes         String?
  adminNote     String?
  completedAt   DateTime?
  createdAt     DateTime           @default(now())

  dealer Dealer @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([dealerId, createdAt])
  @@map("photo_requests")
}

// ─────────── CREDITS, ORDERS, PAYMENTS, INVOICES (§26) ───────────────────
model CreditPack {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  credits     Int
  pricePaise  BigInt
  badge       String?
  highlighted Boolean  @default(false)
  sortOrder   Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  orders Order[]

  @@map("credit_packs")
}

/// The ledger. Append-only. The truth. Never UPDATEd, never DELETEd —
/// a mistake is corrected with a REVERSAL row that references the original.
model CreditTransaction {
  id             String       @id @default(uuid()) @db.Uuid
  /// Append order, and the only safe way to find "the newest row". `createdAt`
  /// is not enough: Postgres gives every statement in one transaction the same
  /// `now()`, so two movements committed together would tie and the running
  /// balance could be read from the wrong one.
  seq            BigInt       @unique @default(autoincrement())
  dealerId       String       @db.Uuid
  delta          Int
  balanceAfter   Int
  reason         CreditReason
  label          String
  listingId      String?      @db.Uuid
  orderId        String?      @db.Uuid
  reversalOfId   String?      @db.Uuid
  actorType      String
  actorId        String?      @db.Uuid
  idempotencyKey String?      @unique
  createdAt      DateTime     @default(now())

  dealer  Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  listing Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@index([dealerId, seq(sort: Desc)])
  @@index([dealerId, createdAt(sort: Desc)])
  @@index([listingId])
  @@map("credit_transactions")
}

model Order {
  id             String      @id @default(uuid()) @db.Uuid
  dealerId       String      @db.Uuid
  packId         String      @db.Uuid
  credits        Int
  amountPaise    BigInt
  taxPaise       BigInt
  totalPaise     BigInt
  currency       String      @default("INR")
  status         OrderStatus @default(PENDING)
  gateway        String      @default("development")
  gatewayOrderId String?     @unique
  idempotencyKey String?     @unique
  createdAt      DateTime    @default(now())
  paidAt         DateTime?

  dealer   Dealer     @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  pack     CreditPack @relation(fields: [packId], references: [id])
  payments Payment[]
  invoices Invoice[]

  @@index([dealerId, createdAt])
  @@index([status, createdAt])
  @@map("orders")
}

model Payment {
  id               String        @id @default(uuid()) @db.Uuid
  orderId          String        @db.Uuid
  dealerId         String        @db.Uuid
  gatewayPaymentId String        @unique
  method           String?
  amountPaise      BigInt
  status           PaymentStatus
  failureReason    String?
  gatewaySignature String?
  rawPayload       Json
  capturedAt       DateTime?
  refundedAt       DateTime?
  createdAt        DateTime      @default(now())

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dealer   Dealer    @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([dealerId, createdAt])
  @@index([status, capturedAt])
  @@map("payments")
}

model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  number        String        @unique
  dealerId      String        @db.Uuid
  orderId       String        @db.Uuid
  paymentId     String?       @db.Uuid
  credits       Int           @default(0)
  amountPaise   BigInt
  taxPaise      BigInt
  totalPaise    BigInt
  status        InvoiceStatus
  failureReason String?
  gstin         String?
  placeOfSupply String?
  pdfMediaKey   String?
  issuedAt      DateTime      @default(now())

  dealer  Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([dealerId, issuedAt(sort: Desc)])
  @@map("invoices")
}

/// Gateway idempotency. Every webhook is INSERTed first; a duplicate delivery
/// collides on gatewayEventId and is acknowledged without re-running anything.
model WebhookEvent {
  id             String    @id @default(uuid()) @db.Uuid
  gateway        String
  gatewayEventId String    @unique
  eventType      String
  payload        Json
  processedAt    DateTime?
  attempts       Int       @default(0)
  error          String?
  createdAt      DateTime  @default(now())

  @@index([processedAt, createdAt])
  @@map("webhook_events")
}

// ─────────── PLATFORM ────────────────────────────────────────────────────
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorType  String
  actorId    String?  @db.Uuid
  dealerId   String?  @db.Uuid
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  ip         String?
  traceId    String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([dealerId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

model OutboxEvent {
  id            BigInt    @id @default(autoincrement())
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  createdAt     DateTime  @default(now())
  publishedAt   DateTime?
  attempts      Int       @default(0)

  @@index([publishedAt, id])
  @@map("outbox_events")
}

model PlatformConfig {
  key       String   @id
  value     Json
  label     String?
  valueType String   @default("string")
  updatedBy String?  @db.Uuid
  updatedAt DateTime @updatedAt

  @@map("platform_config")
}

// Cross-instance shared state — the `CachePort` backing store (§18).
//
// These two tables are cache, not record. Truncating them costs a rate-limit
// window an early reset and a config cache one extra read; nothing here is
// referenced by another table and nothing here is restored from a backup.
model CacheCounter {
  key     String   @id
  count   Int
  /// When this fixed window rolls over. Indexed because the sweeper deletes by it.
  resetAt DateTime @map("reset_at") @db.Timestamptz(6)

  @@index([resetAt])
  @@map("cache_counter")
}

// Bumped by the writer, polled by every other task. This is what lets an admin
// turning a feature off propagate in seconds instead of waiting out a
// five-minute in-process TTL (§18, §30).
model CacheVersion {
  namespace String   @id
  version   BigInt
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("cache_version")
}

