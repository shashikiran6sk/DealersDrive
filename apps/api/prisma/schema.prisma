// Dealers-Drive — database schema.
//
// Every model and enum arrives with the feature that owns it, in the order set
// by `docs/project/feature-map.md`. Money is BigInt paise everywhere, and every
// dealer-owned table carries `dealerId` as a first-class column so tenant
// filtering is one indexed predicate and never a join.
//
// This is the CRITICAL shared file — roughly 25 features append to it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────── IDENTITY (dealers and admins only — no buyer accounts) ──────
model User {
  id              String     @id @default(uuid()) @db.Uuid
  fullName        String?
  roleTitle       String?
  email           String?    @unique
  /// Optional until onboarding collects it: a dealer arrives from Google with a
  /// verified email and nothing else, and an unverified placeholder must never
  /// occupy the unique index (ARCHITECTURE §8.1).
  phone           String?    @unique
  passwordHash    String? // ADMINS ONLY. Dealers sign in with Google.
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  status          UserStatus @default(ACTIVE)
  isPlatformAdmin Boolean    @default(false)
  adminRole       AdminRole?
  totpSecret      String?
  totpEnabledAt   DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())

  sessions    Session[]
  memberships DealerMember[]
  identities  OAuthIdentity[]

  @@map("users")
}

model Session {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @db.Uuid
  tokenHash String       @unique
  /// A dealer session can never satisfy `requireAdmin`, and an admin session can
  /// never satisfy `requireDealer` — even when one human holds both seats.
  scope     SessionScope @default(DEALER)
  expiresAt DateTime
  revokedAt DateTime?
  ip        String?
  userAgent String?
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

/// A verified third-party identity. Dealers sign in with Google and are found
/// by `provider + providerSubject` — Google's `sub`, which is stable — never by
/// the email, which the account holder can change (ARCHITECTURE §8.1 r3).
model OAuthIdentity {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @db.Uuid
  provider        OAuthProvider
  providerSubject String
  /// The address Google asserted at the last sign-in. Informational: it is
  /// refreshed on every login and is never the thing looked up.
  email           String
  emailVerified   Boolean       @default(false)
  displayName     String?
  pictureUrl      String?
  lastLoginAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("oauth_identities")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum SessionScope {
  DEALER
  ADMIN
}

enum OAuthProvider {
  GOOGLE
}

enum AdminRole {
  SUPPORT
  MODERATOR
  SUPER_ADMIN
}

// ─────────── DEALERS (the tenant) ────────────────────────────────────────
model Dealer {
  id                 String       @id @default(uuid()) @db.Uuid
  slug               String       @unique
  /// The display mirror of `legalName`, written by the server and by nothing
  /// else. Onboarding asks for one name; this is where it is shown from.
  brandName          String
  /// Unique **per city** — see `@@unique([legalName, city])` below.
  legalName          String
  /// Unique where present. Nullable columns permit many NULLs in a Postgres
  /// unique index, which is exactly right: a dealership that has not entered a
  /// GSTIN yet must not collide with every other one that has not either.
  gstin              String?      @unique
  pan                String?
  about              String?
  tagline            String?
  logoMediaId        String?      @db.Uuid
  coverMediaId       String?      @db.Uuid
  status             DealerStatus @default(DRAFT)
  /// Locality as text, not as a foreign key to a five-row table.
  ///
  /// `cityId -> cities.id` is gone, and with it the constraint that a
  /// dealership could only exist in a city somebody had seeded. `lat`/`lng`
  /// came off that row and are now written by nothing; they stay because the
  /// distance sort that reads them is a real feature, and geocoding a typed
  /// address is its problem rather than onboarding's.
  city               String?
  state              String?
  addressLine        String?
  pincode            String?
  lat                Float?
  lng                Float?
  contactPhone       String?
  contactEmail       String?
  landline           String?
  workingHours       Json?
  establishedYear    Int?
  specialities       String[]
  /// MIRROR of the newest CreditTransaction.balanceAfter. Never authoritative
  /// on its own — every write path re-reads the ledger under FOR UPDATE (§26.2).
  creditBalance      Int          @default(0)
  creditsHeld        Int          @default(0)
  activeListings     Int          @default(0)
  medianResponseMins Int?
  approvedAt         DateTime?
  suspendedAt        DateTime?
  statusReason       String?
  createdAt          DateTime     @default(now())

  members   DealerMember[]
  documents DealerDocument[]
  // vehicles    Vehicle[]              ← returns with F055
  // listings    Listing[]              ← returns with F064
  // enquiries   Enquiry[]              ← returns with F088
  // ledger      CreditTransaction[]    ← returns with F050
  // orders      Order[]                ← returns with F051
  // payments    Payment[]              ← returns with F052
  // invoices    Invoice[]              ← returns with F053
  // photoReqs   PhotoRequest[]         ← returns with its own feature
  // viewsDaily  ListingViewDaily[]     ← returns with its own feature
  // phoneReveal PhoneReveal[]          ← returns with F090

  /// Two dealerships may share a name; two dealerships in one city may not.
  ///
  /// A global unique on `legalName` was the first shape of this rule, and it
  /// was wrong in a way that only shows up at scale: "Sri Balaji Motors" is a
  /// name three unrelated families use in three different towns, and the first
  /// one to sign up locked the other two out of the product. Within a single
  /// city it is the opposite — the same name is a duplicate application or an
  /// impersonation, and a buyer cannot tell which dealership they are calling.
  ///
  /// Postgres permits many NULLs in a unique index, so a dealership without a
  /// city does not collide with every other one that has none either.
  /// Onboarding always writes one; the nullability is for rows that predate it.
  ///
  /// The index is the guarantee. The service reads first and compares
  /// case-insensitively, because "SRI LAKSHMI MOTORS" would otherwise walk
  /// straight past a case-sensitive index — that read is the error message,
  /// this is the constraint.
  @@unique([legalName, city])
  @@index([status, city])
  @@map("dealers")
}

model DealerMember {
  id          String       @id @default(uuid()) @db.Uuid
  dealerId    String       @db.Uuid
  userId      String       @db.Uuid
  role        DealerRole
  permissions String[]
  status      MemberStatus @default(ACTIVE)

  dealer Dealer @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([dealerId, userId])
  @@index([userId])
  @@map("dealer_members")
}

// ─────────── KYC DOCUMENTS (onboarding step 3) ───────────────────────────
// Private. Stored under a separate prefix with no public delivery route.
//
// The model arrives here rather than at F040 because `dealerInclude` in
// `dealers.repository.ts` pulls `documents` in, and slicing the include would
// mean the repository this feature exists to deliver did not match the
// baseline. F040 brings the service paths, the API and the tests.
model DealerDocument {
  id              String        @id @default(uuid()) @db.Uuid
  dealerId        String        @db.Uuid
  type            DealerDocType
  mediaId         String?       @db.Uuid
  fileName        String?
  status          DocStatus     @default(REQUIRED)
  rejectionReason String?
  reviewedBy      String?       @db.Uuid
  reviewedAt      DateTime?
  createdAt       DateTime      @default(now())

  dealer Dealer @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  @@unique([dealerId, type])
  @@index([status, createdAt])
  @@map("dealer_documents")
}

// ─────────── LOCATIONS ───────────────────────────────────────────────────
// There is no `City` model, and that is the second deliberate divergence from
// the baseline after D1.
//
// D1 removed the vehicle catalogue for the reason recorded in CLAUDE.md §5;
// `City` survived it because cities are not catalogue data. On the evidence of
// the first onboarding flow they are: the table held five towns in one state,
// so it decided which dealerships could exist rather than describing the ones
// that do. `Dealer.city` and `Dealer.state` are text, normalised on write by
// `normaliseLocality` in the contracts package, and search will build its
// facets from the localities dealers actually trade in.
//
enum DealerStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  REJECTED
  CLOSED
}

enum DealerRole {
  OWNER
  MANAGER
  SALES
}

enum MemberStatus {
  ACTIVE
  INVITED
  REMOVED
}

enum DealerDocType {
  GST_CERTIFICATE
  PAN_CARD
  ADDRESS_PROOF
}

enum DocStatus {
  REQUIRED
  UPLOADING
  UPLOADED
  VERIFIED
  REJECTED
}

model PlatformConfig {
  key       String   @id
  value     Json
  label     String?
  valueType String   @default("string")
  updatedBy String?  @db.Uuid
  updatedAt DateTime @updatedAt

  @@map("platform_config")
}

// ─────────── MEDIA (§12) ─────────────────────────────────────────────────
// Content-addressed: a new upload is a new id and a new URL, so a cached page
// never has to be invalidated. `variants` maps a width to a storage key, and
// is written by the processing job — F034.
model Media {
  id              String      @id @default(uuid()) @db.Uuid
  dealerId        String?     @db.Uuid
  ownerType       MediaOwner
  storageKey      String      @unique
  mimeType        String
  bytes           Int
  width           Int?
  height          Int?
  blurhash        String?
  variants        Json        @default("{}")
  fileName        String?
  warnings        String[]
  uploadedByAdmin Boolean     @default(false)
  status          MediaStatus @default(PENDING)
  createdAt       DateTime    @default(now())

  // vehicles VehicleMedia[]   ← returns with F035, which adds VehicleMedia

  @@index([status, createdAt])
  @@map("media")
}

enum MediaOwner {
  VEHICLE
  DEALER_LOGO
  DEALER_COVER
  DEALER_DOCUMENT
}

enum MediaStatus {
  PENDING
  READY
  FAILED
  ORPHAN
}

// Cross-instance shared state — the `CachePort` backing store (§18).
//
// These two tables are cache, not record. Truncating them costs a rate-limit
// window an early reset and a config cache one extra read; nothing here is
// referenced by another table and nothing here is restored from a backup.
model CacheCounter {
  key     String   @id
  count   Int
  /// When this fixed window rolls over. Indexed because the sweeper deletes by it.
  resetAt DateTime @map("reset_at") @db.Timestamptz(6)

  @@index([resetAt])
  @@map("cache_counter")
}

// Bumped by the writer, polled by every other task. This is what lets an admin
// turning a feature off propagate in seconds instead of waiting out a
// five-minute in-process TTL (§18, §30).
model CacheVersion {
  namespace String   @id
  version   BigInt
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("cache_version")
}

// ─────────── PLATFORM ────────────────────────────────────────────────────
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorType  String
  actorId    String?  @db.Uuid
  dealerId   String?  @db.Uuid
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  ip         String?
  traceId    String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([dealerId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

// The transactional outbox (§19.2). A side effect is written here inside the
// same transaction as the state change that caused it, so the two are exactly
// as durable as each other; `outbox-publisher.ts` drains it onto the bus.
model OutboxEvent {
  id            BigInt    @id @default(autoincrement())
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  createdAt     DateTime  @default(now())
  publishedAt   DateTime?
  attempts      Int       @default(0)

  @@index([publishedAt, id])
  @@map("outbox_events")
}
