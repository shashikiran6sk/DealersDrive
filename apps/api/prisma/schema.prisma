// Dealers-Drive — database schema.
//
// Every model and enum arrives with the feature that owns it, in the order set
// by `docs/project/feature-map.md`. Money is BigInt paise everywhere, and every
// dealer-owned table carries `dealerId` as a first-class column so tenant
// filtering is one indexed predicate and never a join.
//
// This is the CRITICAL shared file — roughly 25 features append to it.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: the connection URL is no longer declared here. Migrate reads it
// from `prisma.config.ts`; the running server passes it to `@prisma/adapter-pg`
// in `platform/db/prisma.ts`.
datasource db {
  provider = "postgresql"
}

// ─────────── IDENTITY (dealers and admins only — no buyer accounts) ──────
model User {
  id              String     @id @default(uuid()) @db.Uuid
  fullName        String?
  email           String?    @unique
  /// Optional until onboarding collects it: a dealer arrives from Google with a
  /// verified email and nothing else, and an unverified placeholder must never
  /// occupy the unique index (ARCHITECTURE §8.1).
  ///
  /// **The phone identity** (R59). Written only by a completed OTP (R39), so a
  /// value here *is* a proved handset, and it is how a phone sign-in finds its
  /// account — there is no second table for it to drift from. Always the one
  /// canonical form, `+919840012345`: the `users_phone_canonical` CHECK in the
  /// R59 migration refuses any other spelling.
  phone           String?    @unique
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  status          UserStatus @default(ACTIVE)
  isPlatformAdmin Boolean    @default(false)
  adminRole       AdminRole?
  totpSecret      String?
  totpEnabledAt   DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  /// Set on an account folded into another after the person proved both
  /// identities. The row stays, marked DELETED, so history keeps resolving.
  mergedIntoId    String?    @db.Uuid
  mergedAt        DateTime?

  mergedInto User?  @relation("UserMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  absorbed   User[] @relation("UserMerge")

  adminMember   AdminMember?
  sessions      Session[]
  memberships   DealerMember[]
  identities    OAuthIdentity[]
  roles         UserRole[]
  enquiries     Enquiry[]
  savedVehicles SavedVehicle[]

  enquiriesContacted Enquiry[] @relation("EnquiryContactedBy")
  enquiriesClosed    Enquiry[] @relation("EnquiryClosedBy")

  supportTickets  SupportTicket[]        @relation("SupportTicketCustomer")
  supportMessages SupportTicketMessage[] @relation("SupportMessageAuthor")
  assignedTickets SupportTicket[]        @relation("SupportTicketAssignee")
  supportNotes    SupportTicketNote[]    @relation("SupportNoteAuthor")

  @@map("users")
}

/// What one person is allowed to be, one row per seat (**R41**).
///
/// `users.status` above is an *account*-level switch — the whole person, every
/// door. This table is the per-role one, and the split is the point: one human
/// can hold a dealership seat and an operations seat, and suspending the
/// dealership must close the first without touching the second.
///
/// Before this table existed, suspending a dealership wrote `SUSPENDED` onto
/// every member's `users` row and revoked every session they held. For a member
/// who was also a platform admin that was a second, invisible consequence: the
/// admin console went dark for a decision that was about a yard in Vellore.
///
/// **The rule is one sentence.** A row here refuses its role when it is
/// `SUSPENDED`; an absent row says nothing, and the checks that already existed
/// — the dealership's own status, `isPlatformAdmin`, the admin allow-list —
/// still decide. That is what makes the table safe to add to a live database:
/// it can only ever close a door, never open one.
model UserRole {
  id     String         @id @default(uuid()) @db.Uuid
  userId String         @db.Uuid
  role   PlatformRole
  status UserRoleStatus @default(ACTIVE)

  /// Why the seat was closed, in the words the person is shown. NULL while ACTIVE.
  reason      String?
  suspendedAt DateTime?
  grantedAt   DateTime  @default(now())
  /// The admin who granted the seat, where one did. NULL for a seat the product
  /// created on its own — every dealer who signs in gets a DEALER row.
  grantedBy   String?   @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One row per seat per person. The upsert every sign-in performs rests on it.
  @@unique([userId, role])
  /// "Who holds an operations seat" — the admin-access list, and the only read
  /// this table has that is not keyed by a user.
  @@index([role, status])
  @@map("user_roles")
}

/// The two seats a person can hold. Deliberately **not** `DealerRole`, which is
/// a rank *within* one dealership (OWNER/MANAGER/STAFF), nor `AdminRole`, which
/// is a rank within the console. This is which console you may enter at all.
enum PlatformRole {
  DEALER
  ADMIN
  /// A buyer (**R62**). One person can hold this and `DEALER` at once: a dealer
  /// who signs in on the customer tab with their proved phone reaches the same
  /// user, now with two seats, never a second account.
  CUSTOMER
}

enum UserRoleStatus {
  ACTIVE
  SUSPENDED
}

model Session {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @db.Uuid
  tokenHash      String       @unique
  /// A dealer session can never satisfy `requireAdmin`, and an admin session can
  /// never satisfy `requireDealer` — even when one human holds both seats.
  scope          SessionScope @default(DEALER)
  expiresAt      DateTime
  revokedAt      DateTime?
  ip             String?
  userAgent      String?
  /// The dealership this session is working in (**R93**), for a person who
  /// belongs to more than one. A preference, never a grant: the membership is
  /// re-read on every request, and a dealership this person can no longer
  /// enter is skipped as if this were NULL.
  activeDealerId String?      @db.Uuid
  createdAt      DateTime     @default(now())

  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeDealer Dealer? @relation(fields: [activeDealerId], references: [id], onDelete: SetNull)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

/// A verified third-party identity. Dealers sign in with Google and are found
/// by `provider + providerSubject` — Google's `sub`, which is stable — never by
/// the email, which the account holder can change (ARCHITECTURE §8.1 r3).
model OAuthIdentity {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @db.Uuid
  provider        OAuthProvider
  providerSubject String
  /// The address Google asserted at the last sign-in. Informational: it is
  /// refreshed on every login and is never the thing looked up.
  email           String
  emailVerified   Boolean       @default(false)
  displayName     String?
  pictureUrl      String?
  lastLoginAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("oauth_identities")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

/// `CUSTOMER` (**R62**) is a buyer signed in with their phone. It is a third
/// scope rather than a dealer session with no dealership, because that shape is
/// already taken: a `DEALER` session without a membership is a dealer
/// mid-onboarding, and a customer read that way would be offered a wizard.
enum SessionScope {
  DEALER
  ADMIN
  CUSTOMER
}

enum OAuthProvider {
  GOOGLE
}

/// `MODERATOR` is the Operations reviewer; `SALES_REP` works the Sales
/// workspace only and holds no console permission at all.
enum AdminRole {
  SUPPORT
  MODERATOR
  SUPER_ADMIN
  SALES_REP
}

/// An internal team member: one named person, one role, one lifecycle.
///
/// This row is the authorization. Google proves who signed in; whether that
/// person may enter the console, and as what, is read from here on every
/// request — so a role change applies to the next request and a disabled
/// member's sessions stop working at once.
///
/// `users.isPlatformAdmin`, `users.adminRole` and the ADMIN `user_roles` seat
/// are still written alongside it so an application rollback keeps the same
/// answers; nothing reads them for authorization any more.
model AdminMember {
  id     String            @id @default(uuid()) @db.Uuid
  userId String            @unique @db.Uuid
  role   AdminRole
  status AdminMemberStatus @default(INVITED)
  /// BOOTSTRAP members exist because their address is on ADMIN_ALLOWLIST and
  /// are admitted only while it still is. INVITED members were added by a
  /// Super admin and are admitted while ACTIVE.
  source AdminMemberSource @default(INVITED)

  invitedBy      String?   @db.Uuid
  invitedAt      DateTime  @default(now())
  activatedAt    DateTime?
  lastLoginAt    DateTime?
  disabledAt     DateTime?
  disabledBy     String?   @db.Uuid
  disabledReason String?
  roleChangedAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user                   User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  assistedDealers        Dealer[]
  requestedVerifications DealerEmailVerification[]
  createdVehicles        Vehicle[]                 @relation("VehicleCreatedByMember")
  submittedListings      Listing[]                 @relation("ListingSubmittedByMember")

  @@index([status, role])
  @@map("admin_members")
}

enum AdminMemberStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum AdminMemberSource {
  BOOTSTRAP
  INVITED
}

// ─────────── DEALERS (the tenant) ────────────────────────────────────────
model Dealer {
  id                     String                 @id @default(uuid()) @db.Uuid
  slug                   String                 @unique
  /// The display mirror of `legalName`, written by the server and by nothing
  /// else. Onboarding asks for one name; this is where it is shown from.
  brandName              String
  /// Unique **per city** — see `@@unique([legalName, city])` below.
  legalName              String
  /// Unique where present. Nullable columns permit many NULLs in a Postgres
  /// unique index, which is exactly right: a dealership that has not entered a
  /// GSTIN yet must not collide with every other one that has not either.
  gstin                  String?                @unique
  /// Unique where present, on the same reasoning as `gstin` above — a PAN
  /// identifies one taxable entity, so two dealerships holding one is one
  /// business applying twice or a typo carrying somebody else's identity into a
  /// KYC review. Nullable, so the many dealerships that have not entered one
  /// yet do not collide with each other (**R38**).
  pan                    String?                @unique
  tagline                String?
  logoMediaId            String?                @db.Uuid
  coverMediaId           String?                @db.Uuid
  status                 DealerStatus           @default(DRAFT)
  /// Locality as text, not as a foreign key to a five-row table.
  ///
  /// `cityId -> cities.id` is gone, and with it the constraint that a
  /// dealership could only exist in a city somebody had seeded. `lat`/`lng`
  /// came off that row and are now written by nothing; they stay because the
  /// distance sort that reads them is a real feature, and geocoding a typed
  /// address is its problem rather than onboarding's.
  city                   String?
  /// The district the yard sits in, typed by the dealer and normalised on
  /// write. The admin console filters on it — city on its own is ambiguous
  /// across India, and support questions are district-shaped.
  district               String?
  state                  String?
  addressLine            String?
  pincode                String?
  /// The dealer's own Google Maps share link, stored verbatim.
  ///
  /// Verbatim is the point: a share link survives the dealer moving their pin,
  /// carries the place's own name and reviews, and opens the Maps app rather
  /// than a web map on a phone. It is host-checked on write (`GoogleMapsUrl` in
  /// contracts) because a buyer's browser follows it from a public page.
  ///
  /// The three columns below are read *out* of it at write time (**R10**,
  /// `platform/maps/maps-link.ts`) and never geocoded from the address above.
  /// They are what the portfolio draws with; this is what it links to.
  mapsUrl                String?
  lat                    Float?
  lng                    Float?
  /// Google's own feature id for the yard, `0x…:0x…`, when the link named one.
  ///
  /// The pin centres a map. This makes it a map *of a dealership*: handed back
  /// to Google in an embed it returns the place card — name, address, rating,
  /// review count and a directions control inside the frame — where a bare
  /// `lat,lng` returns an unlabelled dot.
  ///
  /// Nullable and not backfilled. A link that already carries the id has it
  /// read back out at request time, so the only rows this column exists for are
  /// the ones whose id cost a redirect to discover: `maps.app.goo.gl`, which is
  /// what Google's Share sheet gives on a phone.
  mapsPlaceId            String?
  contactPhone           String?
  contactEmail           String?
  /// The contact person's name, for an assisted dealership that has no owner
  /// account yet. A self-onboarded dealership reads it from the OWNER's user.
  contactName            String?
  /// When `contactPhone` was proved by OTP on the dealer's handset during
  /// assisted onboarding. Self-onboarded dealerships prove the owner's phone on
  /// the user row instead, so this stays NULL for them.
  contactPhoneVerifiedAt DateTime?
  /// When the dealer proved they receive mail at `contactEmail`. An address a
  /// Sales Representative typed is never trusted until this is set.
  contactEmailVerifiedAt DateTime?
  /// SELF — the dealer onboarded themselves. ASSISTED — a Sales Representative
  /// did it with them, recorded in `assistedByMemberId`. The lifecycle is the
  /// same either way; only who did the typing differs.
  onboardingSource       DealerOnboardingSource @default(SELF)
  /// The Admin Member who assisted. They assist; they never own — ownership is
  /// a DealerMember OWNER row, which only the dealer's own sign-in creates.
  assistedByMemberId     String?                @db.Uuid
  /// When the dealership representative gave consent, by sharing the OTP, for
  /// Dealers-Drive to create and submit this profile on their behalf.
  assistedConsentAt      DateTime?
  landline               String?
  workingHours           Json?
  establishedYear        Int?
  specialities           String[]
  /// MIRROR of the newest CreditTransaction.balanceAfter. Never authoritative
  /// on its own — every write path re-reads the ledger under FOR UPDATE (§26.2).
  creditBalance          Int                    @default(0)
  creditsHeld            Int                    @default(0)
  activeListings         Int                    @default(0)
  medianResponseMins     Int?
  approvedAt             DateTime?
  suspendedAt            DateTime?
  statusReason           String?
  createdAt              DateTime               @default(now())

  assistedBy         AdminMember?                 @relation(fields: [assistedByMemberId], references: [id], onDelete: Restrict)
  members            DealerMember[]
  invitations        DealerInvitation[]
  sessions           Session[]
  documents          DealerDocument[]
  profileEdits       DealerProfileChange[]
  notifications      NotificationDelivery[]
  vehicles           Vehicle[]
  listings           Listing[]
  enquiries          Enquiry[]
  reactivations      ListingReactivationRequest[]
  emailVerifications DealerEmailVerification[]
  // ledger      CreditTransaction[]    ← returns with F050
  // orders      Order[]                ← returns with F051
  // payments    Payment[]              ← returns with F052
  // invoices    Invoice[]              ← returns with F053
  // photoReqs   PhotoRequest[]         ← returns with its own feature
  // viewsDaily  ListingViewDaily[]     ← returns with its own feature
  // phoneReveal PhoneReveal[]          ← returns with F090

  /// Two dealerships may share a name; two dealerships in one city may not.
  ///
  /// A global unique on `legalName` was the first shape of this rule, and it
  /// was wrong in a way that only shows up at scale: "Sri Balaji Motors" is a
  /// name three unrelated families use in three different towns, and the first
  /// one to sign up locked the other two out of the product. Within a single
  /// city it is the opposite — the same name is a duplicate application or an
  /// impersonation, and a buyer cannot tell which dealership they are calling.
  ///
  /// Postgres permits many NULLs in a unique index, so a dealership without a
  /// city does not collide with every other one that has none either.
  /// Onboarding always writes one; the nullability is for rows that predate it.
  ///
  /// The index is the guarantee. The service reads first and compares
  /// case-insensitively, because "SRI LAKSHMI MOTORS" would otherwise walk
  /// straight past a case-sensitive index — that read is the error message,
  /// this is the constraint.
  @@unique([legalName, city])
  @@index([status, city])
  /// The admin console's location filters, which are always narrowed from the
  /// outside in: a state, then a district within it, then a town.
  @@index([state, district, city])
  /// "My dealerships" in the Sales workspace, and per-member sales reporting.
  @@index([assistedByMemberId, status])
  @@map("dealers")
}

/// One person's place in one dealership (**R92**). A person may hold several,
/// one per dealership; there is deliberately no `users.dealerId`.
///
/// What the role allows is `DEALER_PERMISSIONS` in contracts — a fixed table,
/// not this row. `permissions` is a baseline column nothing reads or writes.
model DealerMember {
  id          String       @id @default(uuid()) @db.Uuid
  dealerId    String       @db.Uuid
  userId      String       @db.Uuid
  role        DealerRole
  permissions String[]
  status      MemberStatus @default(ACTIVE)
  /// Who brought them in (**R94**): the owner whose invitation they accepted.
  /// NULL for an OWNER created by onboarding.
  invitedBy   String?      @db.Uuid
  /// Set when an owner removes them. The row stays — the audit trail and the
  /// `contactedBy` of enquiries they worked still point at a person — and an
  /// invitation accepted later reactivates it rather than adding a second.
  removedAt   DateTime?
  removedBy   String?      @db.Uuid
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now()) @updatedAt

  dealer Dealer @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One row per person per dealership, whatever its status — a removed member
  /// who is invited back gets their old row reactivated, never a second one.
  @@unique([dealerId, userId])
  /// "Which dealerships may this person enter" — read on every dealer request.
  @@index([userId, status])
  /// The team list.
  @@index([dealerId, status])
  @@map("dealer_members")
}

/// An owner's invitation to a mobile number (**R94**).
///
/// Held against the **number**, not an account: whoever next proves that number
/// with the ordinary sign-in may accept it, whether they have used Dealers-Drive
/// before or not. There is no token, so nothing can be forwarded or replayed;
/// acceptance compares this number with the session's verified one.
///
/// ⚠️ A **partial unique index** not expressible here keeps one invitation
/// waiting per number per dealership:
///
///     UNIQUE (dealerId, phone) WHERE status = 'PENDING'
///
/// Inviting a number again amends that row — a new role, a fresh expiry —
/// rather than adding a second. See `migrations/20261002110000_dealer_invitations`.
model DealerInvitation {
  id          String           @id @default(uuid()) @db.Uuid
  dealerId    String           @db.Uuid
  /// Canonical `+91…`, the form `users.phone` holds.
  phone       String
  role        DealerRole
  status      InvitationStatus @default(PENDING)
  invitedBy   String?          @db.Uuid
  expiresAt   DateTime
  /// The person who accepted or declined it.
  respondedBy String?          @db.Uuid
  respondedAt DateTime?
  revokedBy   String?          @db.Uuid
  revokedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt

  dealer Dealer @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  /// "Invitations waiting for this number" — read when a person signs in.
  @@index([phone, status])
  /// The Team page.
  @@index([dealerId, status, createdAt])
  @@map("dealer_invitations")
}

/// EXPIRED is written lazily: a PENDING row past `expiresAt` is treated as
/// expired by every read, and stored as such the next time it is touched.
enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
  EXPIRED
}

// ─────────── KYC DOCUMENTS (onboarding step 3) ───────────────────────────
// Private. Stored under a separate prefix with no public delivery route.
//
// The model arrives here rather than at F040 because `dealerInclude` in
// `dealers.repository.ts` pulls `documents` in, and slicing the include would
// mean the repository this feature exists to deliver did not match the
// baseline. F040 brings the service paths, the API and the tests.
model DealerDocument {
  id              String        @id @default(uuid()) @db.Uuid
  dealerId        String        @db.Uuid
  type            DealerDocType
  mediaId         String?       @db.Uuid
  fileName        String?
  status          DocStatus     @default(REQUIRED)
  rejectionReason String?
  reviewedBy      String?       @db.Uuid
  reviewedAt      DateTime?
  createdAt       DateTime      @default(now())

  dealer Dealer @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  @@unique([dealerId, type])
  @@index([status, createdAt])
  @@map("dealer_documents")
}

// ─────────── PROFILE EDITS AWAITING REVIEW (R34) ─────────────────────────
// The two things a verified dealership may still change about itself, held
// between the dealer pressing Save and a moderator agreeing.
//
// **Why they are held at all.** The tagline and the service list are the only
// free text a dealer writes that a buyer reads, which makes them the only place
// a phone number can reach a public page without going through
// `POST /v1/vehicles/:id/reveal-contact` — the one route allowed to hand one
// out, rate-limited twice over and logged as a lead (rule 7). Everything else
// on the profile screen has been read-only since R27 for the same family of
// reasons; these two were left editable because a dealership is entitled to
// revise how it describes itself. Both facts are true, and a queue is what
// reconciles them.
//
// **The live values are never in this table.** `dealers.tagline` and
// `dealers.specialities` stay exactly as they were until an approval writes
// them, which is what makes a rejection a no-op rather than a restore: there is
// nothing to put back, because nothing was taken away.
model DealerProfileChange {
  id       String              @id @default(uuid()) @db.Uuid
  dealerId String              @db.Uuid
  status   ProfileChangeStatus @default(PENDING)

  /// The proposed line, or NULL when this request does not touch it.
  ///
  /// NULL is unambiguous here in a way it would not be on `dealers.tagline`:
  /// the field cannot be *emptied* — `DealerSelfUpdateInput` puts a floor of
  /// ten characters on it — so a request carrying NULL is a request about the
  /// services only. The same reasoning gives the empty array below its meaning:
  /// the floor on the list is one entry.
  tagline      String?
  specialities String[]

  /// Who typed it. `dealerId` says whose profile; this says whose hands.
  submittedBy    String?   @db.Uuid
  createdAt      DateTime  @default(now())
  reviewedBy     String?   @db.Uuid
  reviewedAt     DateTime?
  /// Why a moderator refused, shown to the dealer verbatim. NULL on approval:
  /// there is nothing to explain about a yes.
  decisionReason String?

  dealer Dealer @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  /// The queue, oldest first.
  ///
  /// ⚠️ There is a **partial unique index** on this table that is not written
  /// here, because Prisma's schema language cannot express one:
  ///
  ///     UNIQUE (dealerId) WHERE status = 'PENDING'
  ///
  /// At most one request waits per dealership. The service never relies on
  /// catching it — a dealer editing again amends the request they already have,
  /// since two rows would make "what is this dealership proposing" a question
  /// with two answers. The index is what makes that true under a race.
  /// See `migrations/20260909160000_dealer_profile_change_review`.
  @@index([status, createdAt])
  /// A dealership's own history, and the newest-first read the profile screen
  /// makes on every render.
  @@index([dealerId, createdAt])
  @@map("dealer_profile_changes")
}

// ─────────── LOCATIONS ───────────────────────────────────────────────────
// There is no `City` model, and that is the second deliberate divergence from
// the baseline after D1.
//
// D1 removed the vehicle catalogue for the reason recorded in CLAUDE.md §5;
// `City` survived it because cities are not catalogue data. On the evidence of
// the first onboarding flow they are: the table held five towns in one state,
// so it decided which dealerships could exist rather than describing the ones
// that do. `Dealer.city` and `Dealer.state` are text, normalised on write by
// `normaliseLocality` in the contracts package, and search will build its
// facets from the localities dealers actually trade in.
//
enum DealerStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  REJECTED
  CLOSED
}

/// R92 renamed `SALES` to `STAFF` in place (`ALTER TYPE … RENAME VALUE`).
enum DealerOnboardingSource {
  SELF
  ASSISTED
}

enum DealerRole {
  OWNER
  MANAGER
  STAFF
}

enum MemberStatus {
  ACTIVE
  INVITED
  REMOVED
}

enum DealerDocType {
  GST_CERTIFICATE
  PAN_CARD
  ADDRESS_PROOF
}

enum DocStatus {
  REQUIRED
  UPLOADING
  UPLOADED
  VERIFIED
  REJECTED
}

/// R34. Three states and no more — see `ProfileChangeStatus` in contracts for
/// why there is no DRAFT and no WITHDRAWN.
enum ProfileChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─────────── VEHICLES (F055, as revised by R45/R46) ──────────────────────
/// A car a dealership has entered, typed by the dealer field by field (R46).
///
/// Every descriptive column is nullable because a draft is saved step by step:
/// the wizard persists what the dealer has typed so far, and the question "is
/// this complete enough to submit" is answered by `vehicleCompleteness` in
/// contracts, once, for both apps. Only the registration number is required —
/// it is the first thing the dealer enters and the thing the draft is created
/// from.
///
/// There is no image here and no image id. Listing photographs belong to
/// Dealers-Drive (R45) and arrive with the admin media model.
model Vehicle {
  id       String @id @default(uuid()) @db.Uuid
  dealerId String @db.Uuid

  /// Canonical form, upper-case and unseparated: `KA01AB1234`, `22BH1234AA`.
  /// Formatted for display on the way out, never stored formatted.
  registrationNumber String
  /// The RTO the registration was issued by, derived from the number on write.
  rtoCode            String?

  make              String?
  model             String?
  variant           String?
  manufacturingYear Int?
  registrationYear  Int?
  fuelType          FuelType?
  transmission      Transmission?
  bodyType          BodyType?

  kilometersDriven    Int?
  ownerCount          Int?
  /// One of twelve generic families (**R52**), never a manufacturer's shade —
  /// the listing form offers these and the search filters on them.
  color               VehicleColor?
  /// The colour as it was typed before R52 made it a choice. Written by
  /// nothing; kept so the backfill into `color` can be audited or redone, and
  /// read by nothing public.
  legacyColor         String?
  insuranceType       InsuranceType?
  insuranceValidUntil DateTime?      @db.Date

  /// Money is BigInt paise (rule 3). `64500000` is ₹6,45,000.
  pricePaise    BigInt?
  negotiability PriceNegotiability?
  description   String?

  /// When this vehicle stopped holding its registration number — it was sold
  /// or rejected (R47). NULL while it holds it, which is every state a dealer
  /// can still act on — a withdrawn car included, so it can be relisted (R69).
  releasedAt DateTime?
  /// When this vehicle first entered review, which is when its registration
  /// stopped being the dealership's private note and became a claim on the
  /// marketplace (F065). See the second partial unique index below.
  claimedAt  DateTime?

  /// The dealer member who created the row. `dealerId` says whose car; this
  /// says whose hands.
  createdBy         String?  @db.Uuid
  /// The Sales Representative who created this vehicle on the dealer's behalf
  /// (**R114**). NULL for every vehicle a dealer created themselves. Moderation
  /// refuses this member every decision on its listing.
  createdByMemberId String?  @db.Uuid
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  dealer          Dealer              @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  createdByMember AdminMember?        @relation("VehicleCreatedByMember", fields: [createdByMemberId], references: [id], onDelete: Restrict)
  listing         Listing?
  photography     VehiclePhotography?
  images          VehicleMedia[]

  /// A dealership's own vehicles, newest first — the inventory read.
  @@index([dealerId, createdAt])
  /// A Sales Representative's drafts for one dealership.
  @@index([createdByMemberId, dealerId])
  /// The marketplace search's brand filter and its brand and model facets
  /// (**F076**). See `migrations/20260927100000_vehicle_search_index`.
  @@index([make, model])
  /// "Which cars carry this registration" — the duplicate check.
  ///
  /// ⚠️ There is also a **partial unique index** Prisma cannot express:
  ///
  ///     UNIQUE (dealerId, registrationNumber) WHERE releasedAt IS NULL
  ///
  /// A dealership holds a registration once. See
  /// `migrations/20260926190000_vehicle_registration_held`. And a second one:
  ///
  ///     UNIQUE (registrationNumber) WHERE releasedAt IS NULL AND claimedAt IS NOT NULL
  ///
  /// Across the marketplace, one car is in review or live once. See
  /// `migrations/20260926210000_vehicle_registration_claimed`.
  @@index([registrationNumber])
  @@map("vehicles")
}

/// Where a vehicle is in its life on the marketplace (**F064**, as revised by
/// **R47**). One per vehicle, created with it as DRAFT.
///
/// **`status` is written in exactly one place**: `transition()` in
/// `modules/listings/listing.state.ts`. No route, no service and no schema a
/// dealer or an admin can post writes it. `transition()` checks the source
/// state and the actor, writes the new state with the old one in the `WHERE`
/// (so two racing decisions cannot both win), and writes the audit row in the
/// same transaction.
model Listing {
  id        String        @id @default(uuid()) @db.Uuid
  vehicleId String        @unique @db.Uuid
  dealerId  String        @db.Uuid
  status    ListingStatus @default(DRAFT)

  /// The first submission. `lastSubmittedAt` moves on every resubmission and
  /// orders the moderation queue; this one does not.
  submittedAt      DateTime?
  lastSubmittedAt  DateTime?
  submissionCount  Int               @default(0)
  /// When the listing first went live. It is what the public sort uses.
  publishedAt      DateTime?
  /// The public address of the listing (**F075**, **F082**): minted once, at
  /// the first approval, and never reused. The only identifier a buyer sees.
  slug             String?           @unique
  /// When the current reservation began (**R69**). Cleared when the listing
  /// goes back on sale; the audit log keeps every earlier one.
  reservedAt       DateTime?
  soldAt           DateTime?
  /// When the dealer took the listing off sale without selling it (**R69**,
  /// was `removedAt`). Cleared, with the reason and note, on a relist.
  withdrawnAt      DateTime?
  /// Why it was withdrawn. Internal: shown to the dealership, never public.
  withdrawalReason WithdrawalReason?
  /// The dealer's own words about a withdrawal. Internal, like the reason.
  withdrawalNote   String?

  /// The moderator's last decision, and the words the dealer is shown. A
  /// request for changes or a rejection always carries one; an approval clears it.
  decisionReason      String?
  decidedBy           String?   @db.Uuid
  decidedAt           DateTime?
  /// The Sales Representative who made the latest submission on the dealer's
  /// behalf (**R114**); NULL when the dealer submitted it themselves.
  submittedByMemberId String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicle           Vehicle                      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  submittedByMember AdminMember?                 @relation("ListingSubmittedByMember", fields: [submittedByMemberId], references: [id], onDelete: Restrict)
  dealer            Dealer                       @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  checks            ListingCheck[]
  enquiries         Enquiry[]
  savedBy           SavedVehicle[]
  reactivations     ListingReactivationRequest[]

  /// A dealership's inventory filtered by status, most recently touched first.
  @@index([dealerId, status, updatedAt])
  /// The moderation queue, oldest submission first.
  @@index([status, lastSubmittedAt])
  /// Public reads: ACTIVE, newest first.
  @@index([status, publishedAt])
  @@map("listings")
}

/// A dealer's request to put a RESERVED or WITHDRAWN listing back on sale.
///
/// A dealership cannot make that move itself: `reactivate` and `relist` are
/// admin events in `listing.state.ts`. The dealer files one of these, an admin
/// approves (the listing goes ACTIVE, in the same transaction, through
/// `transition()`) or rejects (the listing is untouched). A request the listing
/// outran — the reserved car was sold while it waited — is CANCELLED by the
/// transition that moved the listing, so a stale request can never be approved.
///
/// `dealerId` is the listing's, copied on write and never accepted from a
/// request (rule 1).
model ListingReactivationRequest {
  id          String                    @id @default(uuid()) @db.Uuid
  listingId   String                    @db.Uuid
  dealerId    String                    @db.Uuid
  /// The listing's status when the request was filed: RESERVED or WITHDRAWN
  /// (a CHECK constraint). Approval refuses unless the listing is still in it.
  fromStatus  ListingStatus
  status      ReactivationRequestStatus @default(PENDING)
  /// The dealer's own words to the reviewer. Internal, never public.
  reason      String?
  requestedBy String?                   @db.Uuid
  requestedAt DateTime                  @default(now())
  reviewedBy  String?                   @db.Uuid
  reviewedAt  DateTime?
  /// The reviewer's note on a decision, shown to the dealer verbatim.
  adminNote   String?

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  dealer  Dealer  @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  /// ⚠️ There is a **partial unique index** Prisma cannot express:
  ///
  ///     UNIQUE (listingId) WHERE status = 'PENDING'
  ///
  /// At most one request waits per listing, whatever two tabs race to file.
  /// See `migrations/20260930120000_listing_reactivation_requests`.
  ///
  /// The review queue, oldest first.
  @@index([status, requestedAt])
  /// A listing's own requests, newest first.
  @@index([listingId, requestedAt])
  @@index([dealerId])
  @@map("listing_reactivation_requests")
}

/// Mirrors `ReactivationRequestStatus` in contracts.
enum ReactivationRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// Where Dealers-Drive's own photography of a vehicle has got to (**R45**).
///
/// Dealers-Drive photographs every car after it is submitted, processes the
/// pictures in StudioCar (a separate product), and an admin uploads the
/// finished files. This row is the operations team's note of that progress,
/// set by hand: there is **no StudioCar integration** behind it, and no
/// batch id is invented to look like one. When an import is built, a
/// `studioCarBatchId` and an external reference can be added here as nullable
/// columns without changing anything that reads `status`.
///
/// Absent means NOT_STARTED; the row is created the first time an admin moves
/// it. Approval does not read this status — it checks the uploaded images
/// themselves — so a status set wrongly can mislead a person but never publish
/// a car without photographs.
model VehiclePhotography {
  id        String            @id @default(uuid()) @db.Uuid
  vehicleId String            @unique @db.Uuid
  status    PhotographyStatus @default(NOT_STARTED)
  /// Internal only: where the shoot is booked, what was wrong with a batch.
  /// Never in a dealer or public response.
  note      String?
  updatedBy String?           @db.Uuid
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  /// The queue's readiness filter.
  @@index([status])
  @@map("vehicle_photography")
}

/// Where a vehicle image came from (**R45**). Today only an admin uploads one;
/// a later StudioCar import is a second value, not a redesign.
enum VehicleMediaSource {
  ADMIN_UPLOAD
}

/// A processed photograph attached to a vehicle, in gallery order (**R45**,
/// F035 as reinterpreted). Written only through `/v1/admin`.
model VehicleMedia {
  id        String             @id @default(uuid()) @db.Uuid
  vehicleId String             @db.Uuid
  mediaId   String             @unique @db.Uuid
  /// 0-based, contiguous. Unique per vehicle by a deferrable constraint, so a
  /// reorder can pass through a duplicate inside its transaction.
  position  Int
  /// At most one per vehicle, by a partial unique index.
  isPrimary Boolean            @default(false)
  source    VehicleMediaSource @default(ADMIN_UPLOAD)
  addedBy   String             @db.Uuid
  createdAt DateTime           @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@index([vehicleId, position])
  @@map("vehicle_media")
}

enum PhotographyStatus {
  NOT_STARTED
  SCHEDULED
  PHOTOGRAPHED
  PROCESSING
  READY
}

/// One thing a moderator has verified about a listing (**F070**).
///
/// A row means "checked": unchecking deletes it, so there is no false state to
/// misread. The set is cleared when the dealer resubmits, because a check made
/// against the old data says nothing about the new. Approval (F070/R47)
/// requires every key in `LISTING_CHECK_KEYS` to have a row.
model ListingCheck {
  id        String          @id @default(uuid()) @db.Uuid
  listingId String          @db.Uuid
  key       ListingCheckKey
  checkedBy String          @db.Uuid
  checkedAt DateTime        @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  /// A key is checked once per listing; a second click is a no-op, not a row.
  @@unique([listingId, key])
  @@map("listing_checks")
}

enum ListingCheckKey {
  REGISTRATION
  MAKE_MODEL
  VARIANT
  YEAR
  ODOMETER
  OWNERSHIP
  PRICING
}

/// A signed-in customer's enquiry about one listing (**R64**, revises F088).
///
/// **Identity is a reference, not a copy.** The name and the proved number the
/// dealer sees are read from the customer's `users` row at the moment they are
/// shown, never typed into this row. The number cannot drift — `users.phone`
/// is written only by a completed OTP (R39) — and a customer who corrects the
/// spelling of their name is the same lead, so a snapshot would only preserve
/// a mistake. No `vehicleId` either: a listing has exactly one vehicle
/// (`listings.vehicleId` is unique), so it would be a second copy of a fact.
///
/// `dealerId` is the listing's, copied on write and never accepted from a
/// request — it is the tenant key every dealer read filters on (rule 1).
model Enquiry {
  id            String        @id @default(uuid()) @db.Uuid
  customerId    String        @db.Uuid
  dealerId      String        @db.Uuid
  listingId     String        @db.Uuid
  /// Optional. A customer who only wants a call back sends no text at all.
  message       String?
  status        EnquiryStatus @default(NEW)
  contactedAt   DateTime?
  closedAt      DateTime?
  /// The member who marked it CONTACTED, and who closed it (**R92**). NULL on
  /// rows from before R92, and when that person's account is deleted.
  contactedById String?       @db.Uuid
  closedById    String?       @db.Uuid
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  customer    User    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contactedBy User?   @relation("EnquiryContactedBy", fields: [contactedById], references: [id], onDelete: SetNull)
  closedBy    User?   @relation("EnquiryClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  dealer      Dealer  @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  listing     Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  supportTickets SupportTicket[]

  /// The dealer's inbox: one status tab, newest first (R66).
  @@index([dealerId, status, createdAt])
  /// "Has this customer enquired about this car recently?" — the duplicate guard.
  @@index([customerId, listingId, createdAt])
  /// The listing's own enquiries, and the cascade when a listing goes.
  @@index([listingId])
  /// Admin oversight (R89): every enquiry newest first, and one status tab.
  @@index([createdAt])
  @@index([status, createdAt])
  @@map("enquiries")
}

/// A customer asking Dealers-Drive for help (**R90**).
///
/// A domain of its own, not an enquiry: an enquiry is a customer talking to a
/// dealership; this is a customer talking to us. The two meet only through
/// `enquiryId`, an optional reference to one of the customer's **own**
/// enquiries, through which the dealership and the car are reached rather
/// than copied onto the ticket.
///
/// `number` is the human reference, shown as `DD-1042`. It comes from a
/// Postgres sequence (started at 1001 by the migration), so two requests
/// created at the same instant can never be given the same one — there is no
/// `count + 1` anywhere. The row id stays a UUID and is never the reference.
///
/// `description` is the customer's opening message and is stored here once;
/// the replies that follow are `SupportTicketMessage` rows.
model SupportTicket {
  id              String                @id @default(uuid()) @db.Uuid
  number          Int                   @unique @default(autoincrement())
  customerId      String                @db.Uuid
  category        SupportTicketCategory
  subject         String
  description     String
  status          SupportTicketStatus   @default(OPEN)
  /// Support's own triage. A customer never sets it and is never shown it.
  priority        SupportTicketPriority @default(NORMAL)
  /// Optional, and checked on write to be the customer's own enquiry.
  /// `SetNull`: an enquiry is never deleted by the lifecycle, but a ticket
  /// must outlive one that is removed by hand.
  enquiryId       String?               @db.Uuid
  /// The operator working the ticket (**R91**) — a platform admin, checked on
  /// write. NULL is unassigned. `SetNull`: a removed account leaves the
  /// ticket unassigned rather than taking it with it.
  assignedAdminId String?               @db.Uuid
  createdAt       DateTime              @default(now())
  /// Last activity: set by every message as well as every change, so the
  /// lists sort by what last happened on the ticket.
  updatedAt       DateTime              @updatedAt
  resolvedAt      DateTime?
  closedAt        DateTime?

  customer User                   @relation("SupportTicketCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  enquiry  Enquiry?               @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  assignee User?                  @relation("SupportTicketAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  messages SupportTicketMessage[]
  notes    SupportTicketNote[]

  /// The customer's own list, most recently active first.
  @@index([customerId, updatedAt])
  /// "Tickets about this enquiry" — and the FK's own lookup on SetNull.
  @@index([enquiryId])
  /// The admin queue (R91): every ticket, most recently active first, and
  /// one status tab of it.
  @@index([updatedAt])
  @@index([status, updatedAt])
  /// "Assigned to me" / to one operator, by status.
  @@index([assignedAdminId, status])
  @@map("support_tickets")
}

/// One message in a ticket's public conversation (**R90**).
///
/// `authorType` is set by the route that wrote it — the customer's route
/// writes `CUSTOMER`, the console's writes `SUPPORT` — never by a field in a
/// request, so neither side can write as the other. `authorId` is the person;
/// `SetNull` keeps the conversation when an account is removed.
model SupportTicketMessage {
  id         String               @id @default(uuid()) @db.Uuid
  ticketId   String               @db.Uuid
  authorType SupportMessageAuthor
  authorId   String?              @db.Uuid
  body       String
  createdAt  DateTime             @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User?         @relation("SupportMessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  /// A ticket's conversation in order.
  @@index([ticketId, createdAt])
  @@map("support_ticket_messages")
}

/// A private note on a ticket (**R91**). Support's own working record —
/// "called the dealer at 14:32" — and **never** part of the conversation:
/// a separate table, read only by the console's routes, so no customer query
/// can select it by accident.
model SupportTicketNote {
  id        String   @id @default(uuid()) @db.Uuid
  ticketId  String   @db.Uuid
  authorId  String?  @db.Uuid
  body      String
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User?         @relation("SupportNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@map("support_ticket_notes")
}

enum SupportTicketCategory {
  DEALER_ISSUE
  VEHICLE_LISTING_ISSUE
  ENQUIRY_ISSUE
  ACCOUNT_ISSUE
  TECHNICAL_ISSUE
  GENERAL_QUESTION
  OTHER
}

/// The allowed moves between these live in `SUPPORT_TICKET_TRANSITIONS`
/// (contracts), the one table both the API and the console read.
enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SupportMessageAuthor {
  CUSTOMER
  SUPPORT
}

/// A car a signed-in customer has saved (**R74**, revises F087).
///
/// Server-backed, not `localStorage`: a customer's shortlist follows their
/// account to any device. One row per customer per listing — the pair is the
/// primary way in and unique, so a double tap saves once.
///
/// **Never deleted by the lifecycle.** A saved car that is reserved, sold or
/// withdrawn keeps its row; the Saved cars page says what became of it rather
/// than the list silently shrinking. Only the customer removes a row (or the
/// cascade when an account or a listing is deleted outright).
model SavedVehicle {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @db.Uuid
  listingId  String   @db.Uuid
  createdAt  DateTime @default(now())

  customer User    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  listing  Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  /// One save per customer per car, and the customer's list, newest first.
  @@unique([customerId, listingId])
  @@index([customerId, createdAt])
  /// The cascade when a listing goes, and "how many saved this car".
  @@index([listingId])
  @@map("saved_vehicles")
}

/// Mirrors `EnquiryStatus` in contracts, SPAM included (DESIGN-SPEC §3.15).
enum EnquiryStatus {
  NEW
  CONTACTED
  CLOSED
  SPAM
}

/// `RESERVED` sits after `ACTIVE` so an ascending sort on status puts an
/// available car ahead of a reserved one (**R69**). `WITHDRAWN` was `REMOVED`.
enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  CHANGES_REQUESTED
  ACTIVE
  RESERVED
  REJECTED
  SOLD
  WITHDRAWN
}

/// Why a dealer took a listing off sale without selling it (**R69**).
enum WithdrawalReason {
  NO_LONGER_FOR_SALE
  VEHICLE_ISSUE
  DOCUMENT_ISSUE
  TEMPORARILY_PAUSED
  OTHER
}

enum FuelType {
  PETROL
  DIESEL
  CNG
  ELECTRIC
  HYBRID
  LPG
}

enum Transmission {
  MANUAL
  AUTOMATIC
}

enum BodyType {
  HATCHBACK
  SEDAN
  SUV
  MUV
  LUXURY
}

/// A car's colour as a buyer filters by it (**R52**). Mirrors `VehicleColor`
/// in `packages/contracts/src/enums.ts`.
enum VehicleColor {
  BLACK
  WHITE
  GREY
  SILVER
  RED
  BLUE
  GREEN
  BROWN
  BEIGE
  YELLOW
  ORANGE
  OTHER
}

enum InsuranceType {
  COMPREHENSIVE
  THIRD_PARTY
  NONE
}

enum PriceNegotiability {
  SLIGHTLY
  FIXED
}

model PlatformConfig {
  key       String   @id
  value     Json
  label     String?
  valueType String   @default("string")
  updatedBy String?  @db.Uuid
  updatedAt DateTime @updatedAt

  @@map("platform_config")
}

// ─────────── MEDIA (§12) ─────────────────────────────────────────────────
// Content-addressed: a new upload is a new id and a new URL, so a cached page
// never has to be invalidated. `variants` maps a width to a storage key, and
// is written by the processing job — F034.
model Media {
  id              String      @id @default(uuid()) @db.Uuid
  dealerId        String?     @db.Uuid
  ownerType       MediaOwner
  storageKey      String      @unique
  mimeType        String
  bytes           Int
  width           Int?
  height          Int?
  blurhash        String?
  variants        Json        @default("{}")
  fileName        String?
  warnings        String[]
  uploadedByAdmin Boolean     @default(false)
  status          MediaStatus @default(PENDING)
  createdAt       DateTime    @default(now())

  attachment VehicleMedia?

  @@index([status, createdAt])
  @@map("media")
}

enum MediaOwner {
  VEHICLE
  DEALER_LOGO
  DEALER_COVER
  DEALER_DOCUMENT
}

enum MediaStatus {
  PENDING
  READY
  FAILED
  ORPHAN
}

// Cross-instance shared state — the `CachePort` backing store (§18).
//
// These two tables are cache, not record. Truncating them costs a rate-limit
// window an early reset and a config cache one extra read; nothing here is
// referenced by another table and nothing here is restored from a backup.
model CacheCounter {
  key     String   @id
  count   Int
  /// When this fixed window rolls over. Indexed because the sweeper deletes by it.
  resetAt DateTime @map("reset_at") @db.Timestamptz(6)

  @@index([resetAt])
  @@map("cache_counter")
}

// Bumped by the writer, polled by every other task. This is what lets an admin
// turning a feature off propagate in seconds instead of waiting out a
// five-minute in-process TTL (§18, §30).
model CacheVersion {
  namespace String   @id
  version   BigInt
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("cache_version")
}

// ─────────── PLATFORM ────────────────────────────────────────────────────
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorType  String
  actorId    String?  @db.Uuid
  dealerId   String?  @db.Uuid
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  ip         String?
  traceId    String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([dealerId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

// The transactional outbox (§19.2). A side effect is written here inside the
// same transaction as the state change that caused it, so the two are exactly
// as durable as each other; `outbox-publisher.ts` drains it onto the bus.
/// One row per email the platform has decided to send (**R40**).
///
/// It is three things at once, and the third is why it is a table rather than a
/// log line:
///
///   1. **Idempotency.** `dedupeKey` is unique. The worker claims a row before
///      it talks to Resend, so a job pg-boss delivers twice — which it will,
///      because at-least-once is the only honest delivery guarantee a queue can
///      make — sends one email.
///   2. **Observability.** Which dealer, which template, how many attempts,
///      and the provider's own id for the message. "Did the dealer get the
///      approval email" is a question support asks weekly, and answering it
///      from application logs means grepping for an address.
///   3. **A dead-letter of our own.** pg-boss keeps failed jobs, but its
///        archive is a queue table nobody reads. `status = 'FAILED'` with the
///        last error is a list somebody can work.
model NotificationDelivery {
  id String @id @default(uuid()) @db.Uuid

  /// What makes two attempts the same email: `<template>:<subject id>:<recipient>`.
  ///
  /// Derived from the *event*, never from the attempt — an id generated per job
  /// would be unique per delivery and would deduplicate nothing.
  dedupeKey String @unique

  template  String
  /// **R118.** Email or SMS. For an SMS, `recipient` is the canonical phone
  /// number and `subject` is a description of the message — the text itself is
  /// the DLT-approved template held by the provider.
  channel   NotificationChannel @default(EMAIL)
  /// The address as sent. Kept because a dealer changing their email later must
  /// not silently rewrite the record of where a message actually went.
  recipient String
  subject   String

  /// PENDING while claimed, SENT on success, FAILED once the retries are spent.
  status   NotificationStatus @default(PENDING)
  attempts Int                @default(0)

  /// Resend's own message id, for a support question the provider has to answer.
  providerMessageId String?
  /// The last failure, trimmed. Never a stack trace and never the body.
  lastError         String?

  dealerId String? @db.Uuid
  dealer   Dealer? @relation(fields: [dealerId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  sentAt    DateTime?
  updatedAt DateTime  @updatedAt

  /// The two reads this table has: the failed list, and one dealership's trail.
  @@index([status, createdAt])
  @@index([dealerId, createdAt])
  @@map("notification_deliveries")
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum NotificationChannel {
  EMAIL
  SMS
}

model OutboxEvent {
  id            BigInt    @id @default(autoincrement())
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  createdAt     DateTime  @default(now())
  publishedAt   DateTime?
  attempts      Int       @default(0)

  @@index([publishedAt, id])
  @@map("outbox_events")
}

/// A link sent to an assisted dealership's `contactEmail` (**R113**). Opening it
/// and confirming proves the dealer receives mail there; the same link, with an
/// OTP on the dealership's verified phone, lets the dealer claim ownership.
///
/// The raw token is never stored — it is minted inside the email job and only
/// its SHA-256 lands here, so `tokenHash` is NULL until the email is sent. A
/// newer request, or a change of address, supersedes every older row.
model DealerEmailVerification {
  id                  String    @id @default(uuid()) @db.Uuid
  dealerId            String    @db.Uuid
  /// The address the link was sent to, lower-cased. Confirming only counts
  /// while the dealership's `contactEmail` still equals it.
  email               String
  tokenHash           String?   @unique
  requestedByMemberId String?   @db.Uuid
  sentAt              DateTime?
  expiresAt           DateTime?
  verifiedAt          DateTime?
  claimedAt           DateTime?
  claimedByUserId     String?   @db.Uuid
  supersededAt        DateTime?
  createdAt           DateTime  @default(now())

  dealer      Dealer       @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  requestedBy AdminMember? @relation(fields: [requestedByMemberId], references: [id], onDelete: SetNull)

  @@index([dealerId, createdAt])
  @@map("dealer_email_verifications")
}
