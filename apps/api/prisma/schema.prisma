// Dealers-Drive — database schema.
//
// Every model and enum arrives with the feature that owns it, in the order set
// by `docs/project/feature-map.md`. Money is BigInt paise everywhere, and every
// dealer-owned table carries `dealerId` as a first-class column so tenant
// filtering is one indexed predicate and never a join.
//
// This is the CRITICAL shared file — roughly 25 features append to it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────── IDENTITY (dealers and admins only — no buyer accounts) ──────
model User {
  id              String     @id @default(uuid()) @db.Uuid
  fullName        String?
  roleTitle       String?
  email           String?    @unique
  /// Optional until onboarding collects it: a dealer arrives from Google with a
  /// verified email and nothing else, and an unverified placeholder must never
  /// occupy the unique index (ARCHITECTURE §8.1).
  phone           String?    @unique
  passwordHash    String? // ADMINS ONLY. Dealers sign in with Google.
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  status          UserStatus @default(ACTIVE)
  isPlatformAdmin Boolean    @default(false)
  adminRole       AdminRole?
  totpSecret      String?
  totpEnabledAt   DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())

  sessions    Session[]
  memberships DealerMember[]
  identities  OAuthIdentity[]

  @@map("users")
}

model Session {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @db.Uuid
  tokenHash String       @unique
  /// A dealer session can never satisfy `requireAdmin`, and an admin session can
  /// never satisfy `requireDealer` — even when one human holds both seats.
  scope     SessionScope @default(DEALER)
  expiresAt DateTime
  revokedAt DateTime?
  ip        String?
  userAgent String?
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

/// A verified third-party identity. Dealers sign in with Google and are found
/// by `provider + providerSubject` — Google's `sub`, which is stable — never by
/// the email, which the account holder can change (ARCHITECTURE §8.1 r3).
model OAuthIdentity {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @db.Uuid
  provider        OAuthProvider
  providerSubject String
  /// The address Google asserted at the last sign-in. Informational: it is
  /// refreshed on every login and is never the thing looked up.
  email           String
  emailVerified   Boolean       @default(false)
  displayName     String?
  pictureUrl      String?
  lastLoginAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("oauth_identities")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum SessionScope {
  DEALER
  ADMIN
}

enum OAuthProvider {
  GOOGLE
}

enum AdminRole {
  SUPPORT
  MODERATOR
  SUPER_ADMIN
}

// Cross-instance shared state — the `CachePort` backing store (§18).
//
// These two tables are cache, not record. Truncating them costs a rate-limit
// window an early reset and a config cache one extra read; nothing here is
// referenced by another table and nothing here is restored from a backup.
model CacheCounter {
  key     String   @id
  count   Int
  /// When this fixed window rolls over. Indexed because the sweeper deletes by it.
  resetAt DateTime @map("reset_at") @db.Timestamptz(6)

  @@index([resetAt])
  @@map("cache_counter")
}

// Bumped by the writer, polled by every other task. This is what lets an admin
// turning a feature off propagate in seconds instead of waiting out a
// five-minute in-process TTL (§18, §30).
model CacheVersion {
  namespace String   @id
  version   BigInt
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("cache_version")
}

// ─────────── PLATFORM ────────────────────────────────────────────────────
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorType  String
  actorId    String?  @db.Uuid
  dealerId   String?  @db.Uuid
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  ip         String?
  traceId    String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([dealerId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

// ── Pulled forward from F036 ────────────────────────────────────────────────
// The Dealer and DealerMember MODELS arrive here rather than at F036, because
// modules/auth/cookie-session.adapter.ts resolves the dealer principal by
// reading a DealerMember and its Dealer — and that adapter is F015. A session
// resolver that cannot resolve a dealership is not a session resolver.
//
// F036 keeps the substance of its feature: tenant isolation, the repository,
// the service, the routes and the isolation tests. Only the two table
// definitions and their enums move.
//
// Relation fields pointing at models that do not exist yet are commented out
// and return with the feature that adds the other side.
// ─────────── DEALERS (the tenant) ────────────────────────────────────────
model Dealer {
  id                 String       @id @default(uuid()) @db.Uuid
  slug               String       @unique
  brandName          String
  legalName          String
  gstin              String?
  pan                String?
  about              String?
  tagline            String?
  logoMediaId        String?      @db.Uuid
  coverMediaId       String?      @db.Uuid
  status             DealerStatus @default(DRAFT)
  cityId             String?      @db.Uuid
  addressLine        String?
  pincode            String?
  lat                Float?
  lng                Float?
  contactPhone       String?
  contactEmail       String?
  landline           String?
  workingHours       Json?
  establishedYear    Int?
  specialities       String[]
  /// MIRROR of the newest CreditTransaction.balanceAfter. Never authoritative
  /// on its own — every write path re-reads the ledger under FOR UPDATE (§26.2).
  creditBalance      Int          @default(0)
  creditsHeld        Int          @default(0)
  activeListings     Int          @default(0)
  medianResponseMins Int?
  approvedAt         DateTime?
  suspendedAt        DateTime?
  statusReason       String?
  createdAt          DateTime     @default(now())

  // city        City?               @relation(fields: [cityId], references: [id])   ← returns with its own feature
  members     DealerMember[]
  // vehicles    Vehicle[]   ← returns with its own feature
  // documents   DealerDocument[]   ← returns with its own feature
  // listings    Listing[]   ← returns with its own feature
  // enquiries   Enquiry[]   ← returns with its own feature
  // ledger      CreditTransaction[]   ← returns with its own feature
  // orders      Order[]   ← returns with its own feature
  // payments    Payment[]   ← returns with its own feature
  // invoices    Invoice[]   ← returns with its own feature
  // photoReqs   PhotoRequest[]   ← returns with its own feature
  // viewsDaily  ListingViewDaily[]   ← returns with its own feature
  // phoneReveal PhoneReveal[]   ← returns with its own feature

  @@index([status, cityId])
  @@map("dealers")
}

model DealerMember {
  id          String       @id @default(uuid()) @db.Uuid
  dealerId    String       @db.Uuid
  userId      String       @db.Uuid
  role        DealerRole
  permissions String[]
  status      MemberStatus @default(ACTIVE)

  dealer Dealer @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([dealerId, userId])
  @@index([userId])
  @@map("dealer_members")
}

enum DealerStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  REJECTED
  CLOSED
}

enum DealerRole {
  OWNER
  MANAGER
  SALES
}

enum MemberStatus {
  ACTIVE
  INVITED
  REMOVED
}
