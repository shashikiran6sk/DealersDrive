{
  "name": "@dealers-drive/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Dealers-Drive API \u2014 Express 5 modular monolith",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "dev:worker": "tsx watch --clear-screen=false src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:new": "prisma migrate dev --create-only",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed/index.ts",
    "db:seed:dev": "tsx prisma/seed/dev-dealers.ts",
    "db:bootstrap": "tsx prisma/seed/bootstrap.ts",
    "db:reset": "prisma migrate reset --force --skip-seed",
    "db:studio": "prisma studio",
    "docs:postman": "tsx src/docs/generate-postman.ts",
    "verify:s3": "tsx scripts/verify-s3.ts",
    "storage:relocate": "tsx scripts/relocate-dealer-storage.ts",
    "maps:backfill": "tsx scripts/backfill-dealer-pins.ts",
    "test": "vitest run --coverage",
    "test:watch": "vitest --project unit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3",
    "@aws-sdk/s3-request-presigner": "^3",
    "@dealers-drive/contracts": "workspace:*",
    "@prisma/client": "^6.19.3",
    "blurhash": "^2.0.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "nanoid": "^6.0.1",
    "pg-boss": "^12.30.0",
    "pino": "^10.3.1",
    "sharp": "^0.35.4",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@dealers-drive/config": "workspace:*",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.10.0",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
