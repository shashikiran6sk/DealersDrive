# Synthetic local QA only. Does not change the repository .env.
NODE_ENV=development
APP_ENV=local
HOST=127.0.0.1
PORT=4300
DATABASE_URL=postgresql://dealersdrive:dealersdrive@localhost:5432/dealersdrive_white_label_qa
AUTH_MODE=dev
DEV_DEALER_SLUG=qa-white-label-alpha
API_BASE_URL=http://localhost:4300
MEDIA_BASE_URL=http://localhost:4300/media
WEB_BASE_URL=http://localhost:3300
WEB_ORIGIN=http://localhost:3300
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=/private/tmp/white-label-qa-storage
