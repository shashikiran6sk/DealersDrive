{
  "name": "@dealers-drive/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Zod schemas + inferred types shared by apps/web and apps/api",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./common": {
      "types": "./dist/common.d.ts",
      "import": "./dist/common.js",
      "default": "./dist/common.js"
    },
    "./public": {
      "types": "./dist/public.d.ts",
      "import": "./dist/public.js",
      "default": "./dist/public.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./native-auth": {
      "types": "./dist/native-auth.d.ts",
      "import": "./dist/native-auth.js",
      "default": "./dist/native-auth.js"
    },
    "./vehicle-search": {
      "types": "./dist/vehicle-search.d.ts",
      "import": "./dist/vehicle-search.js",
      "default": "./dist/vehicle-search.js"
    },
    "./saved": {
      "types": "./dist/saved.d.ts",
      "import": "./dist/saved.js",
      "default": "./dist/saved.js"
    },
    "./legal-client": {
      "types": "./dist/legal-client.d.ts",
      "import": "./dist/legal-client.js",
      "default": "./dist/legal-client.js"
    },
    "./enquiry-client": {
      "types": "./dist/enquiry-client.d.ts",
      "import": "./dist/enquiry-client.js",
      "default": "./dist/enquiry-client.js"
    },
    "./support-client": {
      "types": "./dist/support-client.d.ts",
      "import": "./dist/support-client.js",
      "default": "./dist/support-client.js"
    },
    "./customer-account": {
      "types": "./dist/customer-account.d.ts",
      "import": "./dist/customer-account.js",
      "default": "./dist/customer-account.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --coverage",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "test:watch": "vitest"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@dealers-drive/config": "workspace:*",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
