{
  "name": "@dealers-drive/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Zod schemas + inferred types shared by apps/web and apps/api",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@dealers-drive/config": "workspace:*",
    "@types/node": "^22.15.0",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3"
  }
}
