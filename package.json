{
  "name": "dealers-drive",
  "version": "0.0.0",
  "private": true,
  "description": "Dealers-Drive \u2014 B2B2C used-car marketplace monorepo",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "sandbox": "pnpm --filter @dealers-drive/sandbox sandbox",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,css,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,css,yml,yaml}\"",
    "docs:check": "node scripts/check-docs.mjs",
    "clean": "turbo run clean",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v && docker compose up -d",
    "app:up": "bash scripts/app-up.sh",
    "app:down": "docker compose --profile app down",
    "app:logs": "docker compose --profile app logs -f api web",
    "app:seed": "docker compose run --rm seed"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
