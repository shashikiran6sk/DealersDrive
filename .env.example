# ---------------------------------------------------------------------------
# Dealers-Drive — local environment
# Copy to .env at the repo root:  cp .env.example .env
#
# Every value below matches docker-compose.yml, so a fresh clone boots without
# editing anything — except GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET, which are
# yours to create (see "dealer sign-in" below). apps/api/src/config/env.ts
# validates all of this at startup and refuses to boot if a required one is
# missing in production.
# ---------------------------------------------------------------------------

# --- runtime ---------------------------------------------------------------
NODE_ENV=development
# Which environment this is, read at runtime. It drives the amber banner in the
# web app, the `Disallow: /` in robots.txt, and the appEnv in /health/ready.
# `local` here; `dev` and `production` are set in the ECS task definition, never
# in a file and never at build time (docs/DEPLOYMENT.md §F).
APP_ENV=local
LOG_LEVEL=debug

# GIT_SHA is deliberately absent. It is injected as a Docker build argument by
# .github/workflows/release.yml and reported by /health/ready, so a deployment
# can prove which build is serving. Locally it reads `unknown`, which is the
# honest answer for a process that was not built from anything.

# --- api -------------------------------------------------------------------
PORT=4000
HOST=0.0.0.0
# Comma-separated list of browser origins allowed to call the API with cookies.
WEB_ORIGIN=http://localhost:3000
WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000

# --- database --------------------------------------------------------------
DATABASE_URL=postgresql://dealersdrive:dealersdrive@localhost:5432/dealersdrive

# apps/web reads API_BASE_URL and WEB_BASE_URL from this same file, on the
# server, at runtime — never inlined into the browser bundle as NEXT_PUBLIC_*
# (ARCHITECTURE §15.3, rule 9).

# ---------------------------------------------------------------------------
# Dealer sign-in — Google OAuth 2.0 / OpenID Connect
#
# Create an OAuth 2.0 Client ID (type: Web application) at
#   https://console.cloud.google.com/apis/credentials
# and register exactly:
#   Authorized JavaScript origin   http://localhost:3000
#   Authorized redirect URI        http://localhost:4000/v1/auth/google/callback
#
# Never commit the secret. Without these two values the API still runs and the
# marketplace, admin console and Swagger all work — only the "Continue with
# Google" button answers with a configuration error naming what to set.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/v1/auth/google/callback

# --- sessions --------------------------------------------------------------
# Signs the short-lived OAuth transaction cookie. Any value locally; a real
# random secret in production, where the local default is refused at boot.
SESSION_SECRET=dealers-drive-local-session-secret
# EMPTY, here and in every deployed environment (docs/DEPLOYMENT.md §F4).
#
# Each environment serves the web app and the API on one origin — `localhost`
# here, `dev.dealers-drive.com` and `www.dealers-drive.com` there — so the
# cookie is already shared where it needs to be. Setting `.dealers-drive.com`
# would make it shared where it must NOT be: a dev session would be sent to
# production. Host-only cookies cannot cross environments.
SESSION_COOKIE_DOMAIN=

# Set to `dev` to bypass sign-in entirely and act as DEV_DEALER_SLUG — an escape
# hatch for a developer with no Google credentials. Refused in production.
AUTH_MODE=cookie
DEV_DEALER_SLUG=sri-lakshmi-motors

# --- admin console ---------------------------------------------------------
# Read once by `pnpm db:seed`, hashed with Argon2id and dropped. The plaintext
# is never stored, logged or returned. Change it and re-seed to rotate.
DEV_ADMIN_EMAIL=ops@dealers-drive.in
DEV_ADMIN_PASSWORD=dealers-drive-local-admin

# --- object storage: MinIO locally, Cloudflare R2 in production ------------
# One adapter for both — only these five values change. `local` writes to the
# filesystem instead and needs no container; the test suite uses it.
STORAGE_DRIVER=minio
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=dealers-drive
S3_ACCESS_KEY_ID=dealersdrive
S3_SECRET_ACCESS_KEY=dealersdrive
# MinIO needs path-style addressing; R2 accepts it.
S3_FORCE_PATH_STYLE=true
# Signs local presigned upload URLs when STORAGE_DRIVER=local.
UPLOAD_SIGNING_SECRET=dealers-drive-local-upload-secret
MEDIA_BASE_URL=http://localhost:4000/media

# --- payments --------------------------------------------------------------
# `development` settles instantly; `razorpay` is the production adapter.
PAYMENT_PROVIDER=development

# --- email: Mailpit locally, Resend in production --------------------------
# Not used by dealer sign-in — Google verifies the address (there is no email
# OTP). Notifications only.
MAIL_DRIVER=console
MAIL_FROM="Dealers-Drive <no-reply@dealers-drive.com>"
# SMTP_HOST=localhost
# SMTP_PORT=1025
# RESEND_API_KEY=

# --- sms: console locally, MSG91 in production -----------------------------
# Retained infrastructure. Mobile OTP is out of scope: onboarding collects a
# phone number, nothing sends a code to it.
SMS_DRIVER=console
MSG91_AUTH_KEY=
MSG91_SENDER_ID=

# --- vehicle registration lookup (RC) --------------------------------------
# How "Add a vehicle" resolves a number plate into a draft, and where the
# records check on a listing page comes from.
#
#   mock    — deterministic, free, offline. The default, and what the test
#             suite runs against. Intake works end to end on it, including
#             every failure branch: see the reserved plates in mock.adapter.ts.
#   attestr — the real provider. Costs roughly Rs 3 per call, so it is never
#             the default; the API refuses to boot with this set and no token.
RC_LOOKUP_DRIVER=mock
# Override only to point at a sandbox. Defaults to https://api.attestr.com/api/v2
ATTESTR_BASE_URL=
# Basic-auth token. Without it every lookup 503s and dealers fall back to
# typing the details, which is a working but slower product.
ATTESTR_AUTH_TOKEN=
# How long a dealer waits before we give up and offer the manual form. Short
# on purpose: this is on the critical path of adding a car and the fallback is
# one click away, so failing fast beats succeeding slowly.
RC_LOOKUP_TIMEOUT_MS=4000
# Keys the HMAC that rc_lookups stores instead of the plate. Registration
# numbers occupy a small, enumerable space, so an unkeyed digest would be
# reversible by anyone with a loop. Production refuses to boot on this default.
RC_PLATE_HASH_SECRET=dealers-drive-local-plate-secret

# --- errors ----------------------------------------------------------------
# Accepted and validated. No SDK is installed — see the README's "Remaining
# production setup" before relying on it.
SENTRY_DSN=

# --- api reference ---------------------------------------------------------
# Serves Swagger UI and the OpenAPI document at /api/docs. On by default
# outside production; set to true deliberately if a deployed environment
# should expose it.
DOCS_ENABLED=true

# --- shared state ----------------------------------------------------------
# Where rate-limit windows and the config-cache version live.
#
#   memory    — a Map in this process. Correct for `pnpm dev` and the tests,
#               because there is exactly one process to share with.
#   postgres  — the database you already have. What every deployed environment
#               uses, and what `docker compose --profile app` uses so the real
#               driver is exercised on a laptop.
#
# `memory` is REFUSED in production, and that refusal is the reason this
# variable exists: behind N tasks, a process-local counter permits N times every
# limit and reports nothing. Phone reveals cost an SMS each, so the limiter is a
# spend control as much as an anti-scraping one (ARCHITECTURE §18, §9.2).
CACHE_DRIVER=memory

# How long a task may serve its own copy of platform config before re-checking
# the shared version. The ceiling on "how long until an admin's change is live
# everywhere" — ten seconds, against the five-minute cache TTL it short-circuits.
CONFIG_VERSION_POLL_MS=10000

# --- shutdown --------------------------------------------------------------
# Two phases (ARCHITECTURE §20.10).
#
# DRAIN_MS is the pause *before* the listener closes: /health/ready starts
# answering 503 the instant SIGTERM arrives, and the load balancer needs a
# moment to notice. Closing the socket first is what produces the connection
# resets that make a routine deploy look like an outage. Zero locally, because
# nothing is load-balancing your laptop; 5000 in a deployed environment.
#
# TIMEOUT_MS is the total budget after that, after which the process exits
# anyway rather than hanging the deployment. The ECS task's `stopTimeout` must
# exceed DRAIN_MS + TIMEOUT_MS, or SIGKILL arrives mid-drain.
SHUTDOWN_DRAIN_MS=0
SHUTDOWN_TIMEOUT_MS=15000
