# ---------------------------------------------------------------------------
# Dealers-Drive — local environment
# Copy to .env at the repo root:  cp .env.example .env
#
# Every value below matches docker-compose.yml, so a fresh clone boots without
# editing anything. apps/api/src/config/env.ts validates these at startup and
# refuses to boot if a required one is missing in production.
# ---------------------------------------------------------------------------

# --- runtime ---------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug

# --- api -------------------------------------------------------------------
PORT=4000
HOST=0.0.0.0
# Comma-separated list of browser origins allowed to call the API with cookies.
WEB_ORIGIN=http://localhost:3000

# --- database (Day 3) ------------------------------------------------------
DATABASE_URL=postgresql://dealersdrive:dealersdrive@localhost:5432/dealersdrive

# --- web -------------------------------------------------------------------
# Read by apps/web at build + runtime. Must be NEXT_PUBLIC_ to reach the browser.
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# Not read by any code yet — listed so the local stack and the eventual
# production env stay in sync. Wire these up on the day they are needed.
# ---------------------------------------------------------------------------

# --- object storage: MinIO locally, Cloudflare R2 in production (Day 21) ---
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=auto
# S3_BUCKET=dealers-drive
# S3_ACCESS_KEY_ID=dealersdrive
# S3_SECRET_ACCESS_KEY=dealersdrive

# --- email: Mailpit locally, Resend in production (Day 6) ------------------
# SMTP_HOST=localhost
# SMTP_PORT=1025
# MAIL_FROM="Dealers-Drive <no-reply@dealersdrive.com>"
# RESEND_API_KEY=

# --- sms: console locally, MSG91 in production (Day 7) ---------------------
# SMS_PROVIDER=console
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=

# --- errors (Day 2) --------------------------------------------------------
# SENTRY_DSN=
