# ---------------------------------------------------------------------------
# Dealers-Drive — local environment
# Copy to .env at the repo root:  cp .env.example .env
#
# Every value below matches docker-compose.yml, so a fresh clone boots without
# editing anything — except GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET, which are
# yours to create (see "dealer sign-in" below). apps/api/src/config/env.ts
# validates all of this at startup and refuses to boot if a required one is
# missing in production.
# ---------------------------------------------------------------------------

# --- runtime ---------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug

# --- api -------------------------------------------------------------------
PORT=4000
HOST=0.0.0.0
# Comma-separated list of browser origins allowed to call the API with cookies.
WEB_ORIGIN=http://localhost:3000
WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000

# --- database --------------------------------------------------------------
DATABASE_URL=postgresql://dealersdrive:dealersdrive@localhost:5432/dealersdrive

# apps/web reads API_BASE_URL and WEB_BASE_URL from this same file, on the
# server, at runtime — never inlined into the browser bundle as NEXT_PUBLIC_*
# (ARCHITECTURE §15.3, rule 9).

# ---------------------------------------------------------------------------
# Dealer sign-in — Google OAuth 2.0 / OpenID Connect
#
# Create an OAuth 2.0 Client ID (type: Web application) at
#   https://console.cloud.google.com/apis/credentials
# and register exactly:
#   Authorized JavaScript origin   http://localhost:3000
#   Authorized redirect URI        http://localhost:4000/v1/auth/google/callback
#
# Never commit the secret. Without these two values the API still runs and the
# marketplace, admin console and Swagger all work — only the "Continue with
# Google" button answers with a configuration error naming what to set.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/v1/auth/google/callback

# --- sessions --------------------------------------------------------------
# Signs the short-lived OAuth transaction cookie. Any value locally; a real
# random secret in production, where the local default is refused at boot.
SESSION_SECRET=dealers-drive-local-session-secret
# Set to `.dealers-drive.com` in production so web and api share the cookie.
# Leave empty locally: web and api are both on `localhost`, which already do.
SESSION_COOKIE_DOMAIN=

# Set to `dev` to bypass sign-in entirely and act as DEV_DEALER_SLUG — an escape
# hatch for a developer with no Google credentials. Refused in production.
AUTH_MODE=cookie
DEV_DEALER_SLUG=sri-lakshmi-motors

# --- admin console ---------------------------------------------------------
# Read once by `pnpm db:seed`, hashed with Argon2id and dropped. The plaintext
# is never stored, logged or returned. Change it and re-seed to rotate.
DEV_ADMIN_EMAIL=ops@dealers-drive.in
DEV_ADMIN_PASSWORD=dealers-drive-local-admin

# --- object storage: MinIO locally, Cloudflare R2 in production ------------
# One adapter for both — only these five values change. `local` writes to the
# filesystem instead and needs no container; the test suite uses it.
STORAGE_DRIVER=minio
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=dealers-drive
S3_ACCESS_KEY_ID=dealersdrive
S3_SECRET_ACCESS_KEY=dealersdrive
# MinIO needs path-style addressing; R2 accepts it.
S3_FORCE_PATH_STYLE=true
# Signs local presigned upload URLs when STORAGE_DRIVER=local.
UPLOAD_SIGNING_SECRET=dealers-drive-local-upload-secret
MEDIA_BASE_URL=http://localhost:4000/media

# --- payments --------------------------------------------------------------
# `development` settles instantly; `razorpay` is the production adapter.
PAYMENT_PROVIDER=development

# --- email: Mailpit locally, Resend in production --------------------------
# Not used by dealer sign-in — Google verifies the address (there is no email
# OTP). Notifications only.
MAIL_DRIVER=console
MAIL_FROM="Dealers-Drive <no-reply@dealers-drive.com>"
# SMTP_HOST=localhost
# SMTP_PORT=1025
# RESEND_API_KEY=

# --- sms: console locally, MSG91 in production -----------------------------
# Retained infrastructure. Mobile OTP is out of scope: onboarding collects a
# phone number, nothing sends a code to it.
SMS_DRIVER=console
MSG91_AUTH_KEY=
MSG91_SENDER_ID=

# --- errors ----------------------------------------------------------------
# Accepted and validated. No SDK is installed — see the README's "Remaining
# production setup" before relying on it.
SENTRY_DSN=

# --- api reference ---------------------------------------------------------
# Serves Swagger UI and the OpenAPI document at /api/docs. On by default
# outside production; set to true deliberately if a deployed environment
# should expose it.
DOCS_ENABLED=true
