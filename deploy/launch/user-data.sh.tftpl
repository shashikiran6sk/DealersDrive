#!/bin/bash
set -euo pipefail
dnf install -y docker python3 python3-pip iptables
systemctl enable --now docker amazon-ssm-agent
install -d -m 700 /opt/dealers-drive
install -d -m 755 /opt/dealers-drive/aws
printf '%s' '${credential_process}' | base64 -d > /opt/dealers-drive/aws/credentials.cjs
printf '[profile runtime]\ncredential_process = node /run/aws/credentials.cjs\n' > /opt/dealers-drive/aws/config
printf '%s' '${host_py}' | base64 -d > /opt/dealers-drive/host.py
printf '%s' '${compose}' | base64 -d > /opt/dealers-drive/compose.yml
printf '%s' '${caddy}' | base64 -d > /opt/dealers-drive/Caddyfile
printf '%s' '${config}' | base64 -d > /opt/dealers-drive/host.json
python3 -m venv /opt/dealers-drive/venv
/opt/dealers-drive/venv/bin/pip install boto3==1.40.50
install -d /usr/local/lib/docker/cli-plugins
python3 - <<'PY'
import hashlib, pathlib, urllib.request
base = 'https://github.com/docker/compose/releases/download/v2.39.4/docker-compose-linux-aarch64'
data = urllib.request.urlopen(base, timeout=60).read()
expected = urllib.request.urlopen(base + '.sha256', timeout=30).read().decode().split()[0]
assert hashlib.sha256(data).hexdigest() == expected
path = pathlib.Path('/usr/local/lib/docker/cli-plugins/docker-compose')
path.write_bytes(data)
path.chmod(0o755)
ca = urllib.request.urlopen('https://truststore.pki.rds.amazonaws.com/ap-south-1/ap-south-1-bundle.pem', timeout=30).read()
pathlib.Path('/opt/dealers-drive/rds-ca.pem').write_bytes(ca)
PY
cat > /etc/systemd/system/dealers-drive-sync.service <<'UNIT'
[Unit]
Description=Dealers-Drive release and health supervisor
After=docker.service network-online.target
Wants=network-online.target
[Service]
Type=oneshot
ExecStartPre=/bin/sh -c 'iptables -C DOCKER-USER -d 169.254.169.254/32 -j DROP 2>/dev/null || iptables -I DOCKER-USER -d 169.254.169.254/32 -j DROP'
ExecStart=/opt/dealers-drive/venv/bin/python /opt/dealers-drive/host.py sync
TimeoutStartSec=600
UMask=0077
UNIT
cat > /etc/systemd/system/dealers-drive-sync.timer <<'UNIT'
[Unit]
Description=Check release and health every minute
[Timer]
OnBootSec=60
OnUnitInactiveSec=60
[Install]
WantedBy=timers.target
UNIT
systemctl daemon-reload
systemctl enable --now dealers-drive-sync.timer
# Associate the EIP before reading the release pointer, even on an empty stack.
/opt/dealers-drive/venv/bin/python /opt/dealers-drive/host.py bootstrap
