# ---------------------------------------------------------------------------
# Dealers-Drive — the PRODUCTION environment's runtime configuration.
#
# Documentation, not a deployment artifact. Plain values go in the task
# definition's `environment`; every SECRET line is an SSM SecureString
# reference in `secrets`, readable only by the production task role.
#
# Read this side by side with env.dev.example. Every value differs, and that is
# the design: separate database, separate bucket, separate OAuth client,
# separate session secret, separate Sentry project. Nothing is shared, so
# nothing in development can reach anything here — not by configuration
# mistake, and not by a compromised dev credential.
# ---------------------------------------------------------------------------

# ═══ api service ═══════════════════════════════════════════════════════════

NODE_ENV=production
# No banner, robots.txt allows crawling, /health/ready reports `production`.
APP_ENV=production

PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# --- URLs ------------------------------------------------------------------
# www, not the apex: the apex redirects to it at the load balancer. One
# canonical hostname keeps the session cookie, the OAuth redirect URI and every
# SEO canonical pointing at the same place.
WEB_ORIGIN=https://www.dealers-drive.com
WEB_BASE_URL=https://www.dealers-drive.com
API_BASE_URL=https://www.dealers-drive.com
MEDIA_BASE_URL=https://www.dealers-drive.com/media

# --- authentication --------------------------------------------------------
AUTH_MODE=cookie
# `dev` is refused outright in production by apps/api/src/config/env.ts. It
# does not fail on the first request — the process will not start.
GOOGLE_CALLBACK_URL=https://www.dealers-drive.com/v1/auth/google/callback
SESSION_COOKIE_DOMAIN=
SESSION_SECRET=SECRET → /dealers-drive/production/SESSION_SECRET
# 32 random bytes, generated for production and used nowhere else. The API
# refuses to boot if the local development default survives here.

GOOGLE_CLIENT_ID=SECRET → /dealers-drive/production/GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=SECRET → /dealers-drive/production/GOOGLE_CLIENT_SECRET
# The production OAuth client, with exactly one origin and one redirect URI
# registered, and a consent screen that has been published rather than left in
# Testing — a real dealer is not on anybody's test-user list.

# --- database --------------------------------------------------------------
DATABASE_URL=SECRET → /dealers-drive/production/DATABASE_URL
# Its own RDS instance: private subnets, encrypted, automated backups with
# point-in-time recovery, deletion protection on. No development role can read
# this parameter, and no development security group can reach the instance.

# --- object storage --------------------------------------------------------
STORAGE_DRIVER=r2
S3_ENDPOINT=https://<cloudflare-account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=dd-media-prod
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=SECRET → /dealers-drive/production/S3_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=SECRET → /dealers-drive/production/S3_SECRET_ACCESS_KEY
UPLOAD_SIGNING_SECRET=SECRET → /dealers-drive/production/UPLOAD_SIGNING_SECRET

# --- providers -------------------------------------------------------------
# These are the lines that change when a provider goes live. Each one is an
# adapter swap behind a port that is already written and tested — and each one
# should be flipped in dev first, verified, then promoted.
PAYMENT_PROVIDER=development   # → razorpay once the webhook route ships
MAIL_DRIVER=console            # → resend once ResendMailer is written
MAIL_FROM="Dealers-Drive <no-reply@dealers-drive.com>"
SMS_DRIVER=console             # → msg91 once DLT registration clears

# --- runtime behaviour -----------------------------------------------------
JOBS_ENABLED=true
# TRUE, AND THIS IS THE CONSTRAINT THAT CAPS THE API AT ONE TASK.
#
# The job handlers run inside the HTTP process, so a second task would run
# every scheduled job twice. Scaling the API horizontally requires the separate
# worker entrypoint described in docs/DEPLOYMENT.md §C — the same image, a
# different command — at which point this becomes false here and true on a
# worker service. Until then: one task, and vertical scaling if it is not
# enough.
WORKER_INLINE=true
RATE_LIMIT_ENABLED=true
# Off. The document enumerates every endpoint, every permission and every error
# code; that is a map for a developer and a map for an attacker, and production
# needs the first one no more than dev already provides it.
DOCS_ENABLED=false

SENTRY_DSN=SECRET → /dealers-drive/production/SENTRY_DSN

# ═══ web service ═══════════════════════════════════════════════════════════

NODE_ENV=production
APP_ENV=production
PORT=3000
WEB_BASE_URL=https://www.dealers-drive.com
API_BASE_URL=http://dd-api-prod:4000

# ═══ migrate task ══════════════════════════════════════════════════════════

NODE_ENV=development
DATABASE_URL=SECRET → /dealers-drive/production/DATABASE_URL
