{
  "_comment": [
    "Production API example. Use a task role with bucket-scoped S3 permissions.",
    "Fill deployment URLs, bucket, allowlist, widget values, and SSM ARNs before registration."
  ],
  "family": "dd-api-prod",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::<account>:role/dd-ecs-execution",
  "taskRoleArn": "arn:aws:iam::<account>:role/dd-api-task-prod",
  "containerDefinitions": [
    {
      "name": "api",
      "image": "<account>.dkr.ecr.<region>.amazonaws.com/dealers-drive/api:sha-PLACEHOLDER",
      "essential": true,
      "portMappings": [
        {
          "name": "api",
          "containerPort": 4000,
          "protocol": "tcp",
          "appProtocol": "http"
        }
      ],
      "environment": [
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "APP_ENV",
          "value": "production"
        },
        {
          "name": "WEB_ORIGIN",
          "value": "https://www.dealers-drive.com"
        },
        {
          "name": "WEB_BASE_URL",
          "value": "https://www.dealers-drive.com"
        },
        {
          "name": "API_BASE_URL",
          "value": "https://www.dealers-drive.com"
        },
        {
          "name": "MEDIA_BASE_URL",
          "value": "https://www.dealers-drive.com/media"
        },
        {
          "name": "AWS_REGION",
          "value": "ap-south-1"
        },
        {
          "name": "S3_BUCKET",
          "value": "dd-media-prod"
        },
        {
          "name": "ADMIN_ALLOWLIST",
          "value": "ops@dealers-drive.in"
        },
        {
          "name": "MSG91_WIDGET_ID",
          "value": "REPLACE_ME"
        },
        {
          "name": "MSG91_WIDGET_TOKEN",
          "value": "REPLACE_ME"
        },
        {
          "name": "CACHE_DRIVER",
          "value": "postgres"
        },
        {
          "name": "WORKER_INLINE",
          "value": "false"
        }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:ssm:<region>:<account>:parameter/dealers-drive/production/DATABASE_URL"
        },
        {
          "name": "SESSION_SECRET",
          "valueFrom": "arn:aws:ssm:<region>:<account>:parameter/dealers-drive/production/SESSION_SECRET"
        },
        {
          "name": "METRICS_SCRAPE_TOKEN",
          "valueFrom": "arn:aws:ssm:<region>:<account>:parameter/dealers-drive/production/METRICS_SCRAPE_TOKEN"
        },
        {
          "name": "GOOGLE_CLIENT_ID",
          "valueFrom": "arn:aws:ssm:<region>:<account>:parameter/dealers-drive/production/GOOGLE_CLIENT_ID"
        },
        {
          "name": "GOOGLE_CLIENT_SECRET",
          "valueFrom": "arn:aws:ssm:<region>:<account>:parameter/dealers-drive/production/GOOGLE_CLIENT_SECRET"
        },
        {
          "name": "RESEND_API_KEY",
          "valueFrom": "arn:aws:ssm:<region>:<account>:parameter/dealers-drive/production/RESEND_API_KEY"
        },
        {
          "name": "MSG91_AUTH_KEY",
          "valueFrom": "arn:aws:ssm:<region>:<account>:parameter/dealers-drive/production/MSG91_AUTH_KEY"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "node -e \"fetch('http://127.0.0.1:4000/health/ready').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\""
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/dealers-drive/dev/api",
          "awslogs-region": "<region>",
          "awslogs-stream-prefix": "api"
        }
      },
      "stopTimeout": 25
    }
  ]
}
