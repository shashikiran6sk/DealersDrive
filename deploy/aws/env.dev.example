# ---------------------------------------------------------------------------
# Dealers-Drive — the DEVELOPMENT environment's runtime configuration.
#
# This file is documentation, not a deployment artifact. Nothing reads it.
#
# On a laptop, configuration is a `.env` file. In dev and production it is the
# ECS task definition: the plain values below go in `environment`, and every
# value marked SECRET goes in `secrets`, as a reference to an SSM parameter
# that the task's execution role is allowed to read. The difference matters —
# a value in `environment` is visible to anyone with `ecs:DescribeTaskDefinition`,
# and a value in `secrets` is fetched by the agent at start and never appears
# in the definition at all.
#
# Set them once with deploy/aws/README.md §6, then never again: a deploy
# changes the image and nothing else.
# ---------------------------------------------------------------------------

# ═══ api service ═══════════════════════════════════════════════════════════

# --- identity --------------------------------------------------------------
NODE_ENV=production
# Drives the amber "dev — not real data" banner in the web app, the
# `Disallow: /` in robots.txt, and the appEnv field in /health/ready. It is the
# one variable that says which environment this is, and it is read at runtime
# precisely so the same image can be told.
APP_ENV=dev

PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# --- URLs ------------------------------------------------------------------
# One public origin per environment, and both apps live behind it: the load
# balancer sends /v1, /health and /media to this service and everything else to
# the web service. That is what keeps the session cookie host-only — see
# SESSION_COOKIE_DOMAIN below.
WEB_ORIGIN=https://dev.dealers-drive.com
WEB_BASE_URL=https://dev.dealers-drive.com
# Browser-facing: the "Continue with Google" link is built from this value and
# the browser navigates to it. It is NOT the address the web app uses to reach
# this service internally (see the web service below).
API_BASE_URL=https://dev.dealers-drive.com
MEDIA_BASE_URL=https://dev.dealers-drive.com/media

# --- authentication --------------------------------------------------------
AUTH_MODE=cookie
GOOGLE_CALLBACK_URL=https://dev.dealers-drive.com/v1/auth/google/callback
# EMPTY, deliberately, in every environment.
#
# Setting `.dealers-drive.com` here would make the dev cookie valid on
# www.dealers-drive.com and vice versa — one environment's session leaking into
# another's, which is exactly what the three-environment split exists to
# prevent. Host-only cookies cannot cross `dev.` and `www.`, and because each
# environment serves its API on its own hostname there is nothing to share.
SESSION_COOKIE_DOMAIN=
SESSION_SECRET=SECRET → /dealers-drive/dev/SESSION_SECRET
# Different from production's. A secret shared between environments makes the
# less-protected one the way in to the other.

GOOGLE_CLIENT_ID=SECRET → /dealers-drive/dev/GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=SECRET → /dealers-drive/dev/GOOGLE_CLIENT_SECRET
# A SEPARATE Google OAuth client from production's, with only
# https://dev.dealers-drive.com registered as an origin and redirect URI. One
# client shared across environments means a redirect-URI list that accepts a
# staging host — and an OAuth client is only as trustworthy as its shortest
# leash.

# --- database --------------------------------------------------------------
# Its own RDS instance, in a private subnet, reachable only from the ECS
# security group. It is not the production database and cannot become it: the
# production credential is not in this environment's parameter path, and this
# environment's task role cannot read that path.
DATABASE_URL=SECRET → /dealers-drive/dev/DATABASE_URL

# --- object storage --------------------------------------------------------
STORAGE_DRIVER=r2
S3_ENDPOINT=https://<cloudflare-account-id>.r2.cloudflarestorage.com
S3_REGION=auto
# A separate bucket, so a dev upload can never appear on a production listing.
S3_BUCKET=dd-media-dev
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=SECRET → /dealers-drive/dev/S3_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=SECRET → /dealers-drive/dev/S3_SECRET_ACCESS_KEY
# Scoped to dd-media-dev only. An R2 token that can write both buckets makes
# the bucket separation decorative.
UPLOAD_SIGNING_SECRET=SECRET → /dealers-drive/dev/UPLOAD_SIGNING_SECRET

# --- providers -------------------------------------------------------------
# Nothing in dev may contact a real dealer or move real money. These are the
# console adapters; they log what they would have sent.
PAYMENT_PROVIDER=development
MAIL_DRIVER=console
MAIL_FROM="Dealers-Drive (dev) <no-reply@dealers-drive.com>"
SMS_DRIVER=console

# --- runtime behaviour -----------------------------------------------------
JOBS_ENABLED=true
# One process runs HTTP and the job handlers. It is why the api service runs a
# single task in dev: two tasks would register the cron schedules twice.
WORKER_INLINE=true
RATE_LIMIT_ENABLED=true
# The API reference, on in dev. It is a map of every endpoint and permission —
# useful to a developer, and equally useful to anyone probing. Off in production.
DOCS_ENABLED=true

SENTRY_DSN=SECRET → /dealers-drive/dev/SENTRY_DSN
# A separate Sentry project from production's, or dev noise buries the one
# report that matters.

# ═══ web service ═══════════════════════════════════════════════════════════
#
# It holds NO secrets. Every call it makes is server-to-server to the API, and
# the dealer's session cookie is forwarded from the incoming request rather
# than held anywhere.

NODE_ENV=production
APP_ENV=dev
PORT=3000
WEB_BASE_URL=https://dev.dealers-drive.com
# Internal, over ECS Service Connect — not the public URL. A round trip out to
# the load balancer and back for every server-rendered page would pay for TLS
# and an internet hop to reach a container two milliseconds away.
API_BASE_URL=http://dd-api-dev:4000

# ═══ migrate task ══════════════════════════════════════════════════════════
#
# Runs to completion and exits. Only two variables, and one of them is the
# database — deliberately the smallest possible surface for the one task in
# the system that can alter the schema.

NODE_ENV=development
DATABASE_URL=SECRET → /dealers-drive/dev/DATABASE_URL
