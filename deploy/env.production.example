# ---------------------------------------------------------------------------
# Dealers-Drive — production .env for a single EC2 box (investor demo)
#
# Copy this to the REPO ROOT as `.env` on the server:
#   cp deploy/env.production.example .env && nano .env
#
# Replace every __DOMAIN__ with your domain, and every CHANGE_ME with a real
# secret. `apps/api/src/config/env.ts` refuses to boot in production if any of
# the local development defaults survive, so a half-edited file fails loudly at
# start instead of quietly serving an insecure demo.
#
# Generate a secret:  openssl rand -hex 32
# ---------------------------------------------------------------------------

# --- runtime ---------------------------------------------------------------
NODE_ENV=production
APP_ENV=production
LOG_LEVEL=info

# --- api -------------------------------------------------------------------
PORT=4000
HOST=127.0.0.1
# nginx is the only thing that talks to Node; binding to loopback means port
# 4000 is unreachable from the internet even if the security group is wrong.

# Browser origins allowed to call the API with cookies. Comma-separated.
WEB_ORIGIN=https://__DOMAIN__
WEB_BASE_URL=https://__DOMAIN__
# Public, not loopback: this URL is rendered into the sign-in page as the
# "Continue with Google" href, so the browser has to be able to reach it.
API_BASE_URL=https://__DOMAIN__

# --- database --------------------------------------------------------------
# The postgres container from deploy/docker-compose.prod.yml, on loopback.
# POSTGRES_PASSWORD is read by the container; DATABASE_URL is read by the app.
# They must be the same string.
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
DATABASE_URL=postgresql://dealersdrive:CHANGE_ME_DB_PASSWORD@localhost:5432/dealersdrive

# --- dealer sign-in: Google OAuth -----------------------------------------
# Google Cloud console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
#   Authorized JavaScript origin   https://__DOMAIN__
#   Authorized redirect URI        https://__DOMAIN__/v1/auth/google/callback
# Required in production: the API will not start without both values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://__DOMAIN__/v1/auth/google/callback

# --- sessions --------------------------------------------------------------
SESSION_SECRET=CHANGE_ME_openssl_rand_hex_32
# Empty: web and api share one hostname behind nginx, so the cookie is
# host-only and already shared. Keep it that way — a parent-domain cookie is
# also sent to every other environment on the domain (docs/DEPLOYMENT.md §F4).
SESSION_COOKIE_DOMAIN=
AUTH_MODE=cookie
DEV_DEALER_SLUG=sri-lakshmi-motors

# --- admin console ---------------------------------------------------------
# Read once by `pnpm db:seed`, hashed with Argon2id, then dropped. Change this
# before seeding — the value below is what you hand the investor, so make it
# something you are willing to type on a projector.
DEV_ADMIN_EMAIL=ops@__DOMAIN__
DEV_ADMIN_PASSWORD=CHANGE_ME_admin_password

# --- object storage --------------------------------------------------------
# MinIO in Docker on this box. `local` (filesystem) is refused in production;
# swap to r2 by changing S3_ENDPOINT and the two keys, nothing else.
STORAGE_DRIVER=minio
# Public, not loopback. The browser uploads photos straight to the bucket with
# a presigned URL, and that URL is built from this value — so it has to be a
# name the browser can resolve. Point `s3.__DOMAIN__` at this box (see
# deploy/README.md) before you seed.
S3_ENDPOINT=https://s3.__DOMAIN__
S3_REGION=auto
S3_BUCKET=dealers-drive
S3_ACCESS_KEY_ID=dealersdrive
S3_SECRET_ACCESS_KEY=CHANGE_ME_MINIO_PASSWORD
S3_FORCE_PATH_STYLE=true
UPLOAD_SIGNING_SECRET=CHANGE_ME_openssl_rand_hex_32
# The API serves image bytes itself at /media/... — nginx routes that to it.
MEDIA_BASE_URL=https://__DOMAIN__/media

# --- payments / email / sms ------------------------------------------------
# Demo settings: payments settle instantly, mail and sms print to the log.
# Nothing here contacts a real provider, and nothing here needs to.
PAYMENT_PROVIDER=development
MAIL_DRIVER=console
MAIL_FROM="Dealers-Drive <no-reply@__DOMAIN__>"
SMS_DRIVER=console

# --- errors ----------------------------------------------------------------
SENTRY_DSN=

# --- api reference ---------------------------------------------------------
# Off in production by default. Set to true only if you want to show Swagger
# at https://__DOMAIN__/api/docs — it lists every endpoint and permission.
DOCS_ENABLED=false
