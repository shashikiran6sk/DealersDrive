{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Grafana Cloud Metrics",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "11.0.0"
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": ""
    }
  ],
  "annotations": { "list": [] },
  "description": "OAuth semantic results and authentication API traffic, errors, and latency.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "OAuth outcomes",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (audience, outcome) (rate(dealers_drive_oauth_attempts_total{service=\"dealers-drive-api\",environment=~\"$environment\"}[$__rate_interval]))",
          "legendFormat": "{{audience}} · {{outcome}}",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "ops" },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "title": "OAuth failures by reason",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (audience, reason) (increase(dealers_drive_oauth_attempts_total{service=\"dealers-drive-api\",environment=~\"$environment\",outcome!=\"success\"}[$__rate_interval]))",
          "legendFormat": "{{audience}} · {{reason}}",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "decimals": 0 },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "title": "Authentication API traffic",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (method, route) (rate(dealers_drive_http_requests_total{service=\"dealers-drive-api\",environment=~\"$environment\",route=~\"/v1/auth/.*\"}[$__rate_interval]))",
          "legendFormat": "{{method}} {{route}}",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 9 },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "reqps" },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "title": "Authentication status codes",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (route, status_code) (rate(dealers_drive_http_requests_total{service=\"dealers-drive-api\",environment=~\"$environment\",route=~\"/v1/auth/.*\"}[$__rate_interval]))",
          "legendFormat": "{{route}} · {{status_code}}",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 9 },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "reqps" },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "title": "Authentication p50 / p95 / p99",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le, route) (rate(dealers_drive_http_request_duration_seconds_bucket{service=\"dealers-drive-api\",environment=~\"$environment\",route=~\"/v1/auth/.*\"}[$__rate_interval])))",
          "legendFormat": "p50 · {{route}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(dealers_drive_http_request_duration_seconds_bucket{service=\"dealers-drive-api\",environment=~\"$environment\",route=~\"/v1/auth/.*\"}[$__rate_interval])))",
          "legendFormat": "p95 · {{route}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, route) (rate(dealers_drive_http_request_duration_seconds_bucket{service=\"dealers-drive-api\",environment=~\"$environment\",route=~\"/v1/auth/.*\"}[$__rate_interval])))",
          "legendFormat": "p99 · {{route}}",
          "refId": "C"
        }
      ],
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 18 },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "s" },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "title": "Authentication error ratio",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (route) (rate(dealers_drive_http_requests_total{service=\"dealers-drive-api\",environment=~\"$environment\",route=~\"/v1/auth/.*\",status_code=~\"4..|5..\"}[$__rate_interval])) / clamp_min(sum by (route) (rate(dealers_drive_http_requests_total{service=\"dealers-drive-api\",environment=~\"$environment\",route=~\"/v1/auth/.*\"}[$__rate_interval])), 0.001)",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 18 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["dealers-drive", "observability"],
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(dealers_drive_http_requests_total{service=\"dealers-drive-api\"}, environment)",
        "query": {
          "query": "label_values(dealers_drive_http_requests_total{service=\"dealers-drive-api\"}, environment)",
          "refId": "environment"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "current": { "text": "production", "value": "production" }
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Dealers Drive / Authentication & OAuth",
  "uid": "dealers-drive-authentication-oauth",
  "version": 1,
  "weekStart": ""
}
