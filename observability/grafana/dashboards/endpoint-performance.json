{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Grafana Cloud Metrics",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "11.0.0"
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": ""
    }
  ],
  "annotations": { "list": [] },
  "description": "Endpoint and method-level traffic, status, latency, errors, and database attribution.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Request rate by endpoint",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (method, route) (rate(dealers_drive_http_requests_total{service=\"dealers-drive-api\",environment=~\"$environment\"}[$__rate_interval]))",
          "legendFormat": "{{method}} {{route}}",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "reqps" },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "title": "Request total by endpoint",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (method, route) (increase(dealers_drive_http_requests_total{service=\"dealers-drive-api\",environment=~\"$environment\"}[$__range]))",
          "legendFormat": "{{method}} {{route}}",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "decimals": 0 },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "title": "Status codes by endpoint",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (method, route, status_code) (rate(dealers_drive_http_requests_total{service=\"dealers-drive-api\",environment=~\"$environment\"}[$__rate_interval]))",
          "legendFormat": "{{method}} {{route}} · {{status_code}}",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 9 },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "reqps" },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "title": "p50 / p95 / p99 by endpoint",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le,method,route) (rate(dealers_drive_http_request_duration_seconds_bucket{service=\"dealers-drive-api\",environment=~\"$environment\"}[$__rate_interval])))",
          "legendFormat": "p50 · {{method}} {{route}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le,method,route) (rate(dealers_drive_http_request_duration_seconds_bucket{service=\"dealers-drive-api\",environment=~\"$environment\"}[$__rate_interval])))",
          "legendFormat": "p95 · {{method}} {{route}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le,method,route) (rate(dealers_drive_http_request_duration_seconds_bucket{service=\"dealers-drive-api\",environment=~\"$environment\"}[$__rate_interval])))",
          "legendFormat": "p99 · {{method}} {{route}}",
          "refId": "C"
        }
      ],
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 9 },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "s" },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "title": "Average response time by endpoint",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (method, route) (rate(dealers_drive_http_request_duration_seconds_sum{service=\"dealers-drive-api\",environment=~\"$environment\"}[$__rate_interval])) / clamp_min(sum by (method, route) (rate(dealers_drive_http_request_duration_seconds_count{service=\"dealers-drive-api\",environment=~\"$environment\"}[$__rate_interval])), 0.001)",
          "legendFormat": "{{method}} {{route}}",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 18 },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "s" },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "title": "Rolling min / max by endpoint",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "dealers_drive_http_request_extrema_seconds{service=\"dealers-drive-api\",environment=~\"$environment\",quantile=~\"0|1\"}",
          "legendFormat": "{{method}} {{route}} · q={{quantile}}",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 18 },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "s" },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "title": "Average DB time per request",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (method, route) (rate(dealers_drive_http_request_db_duration_seconds_sum{service=\"dealers-drive-api\",environment=~\"$environment\"}[$__rate_interval])) / clamp_min(sum by (method, route) (rate(dealers_drive_http_request_db_duration_seconds_count{service=\"dealers-drive-api\",environment=~\"$environment\"}[$__rate_interval])), 0.001)",
          "legendFormat": "{{method}} {{route}}",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 27 },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "s" },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "title": "Error ratio by endpoint",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (method, route) (rate(dealers_drive_http_requests_total{service=\"dealers-drive-api\",environment=~\"$environment\",status_code=~\"4..|5..\"}[$__rate_interval])) / clamp_min(sum by (method, route) (rate(dealers_drive_http_requests_total{service=\"dealers-drive-api\",environment=~\"$environment\"}[$__rate_interval])), 0.001)",
          "legendFormat": "{{method}} {{route}}",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 27 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["dealers-drive", "observability"],
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(dealers_drive_http_requests_total{service=\"dealers-drive-api\"}, environment)",
        "query": {
          "query": "label_values(dealers_drive_http_requests_total{service=\"dealers-drive-api\"}, environment)",
          "refId": "environment"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "current": { "text": "production", "value": "production" }
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Dealers Drive / Endpoint Performance",
  "uid": "dealers-drive-endpoint-performance",
  "version": 1,
  "weekStart": ""
}
