{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Grafana Cloud Metrics",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "11.0.0"
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": ""
    }
  ],
  "annotations": { "list": [] },
  "description": "Prisma operation volume, latency, errors, slow operations, and request-vs-database time.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Database operation rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (model, operation, outcome) (rate(dealers_drive_db_operations_total{service=\"dealers-drive-api\",environment=~\"$environment\"}[$__rate_interval]))",
          "legendFormat": "{{model}}.{{operation}} · {{outcome}}",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "ops" },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "title": "Database errors",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (model, operation) (increase(dealers_drive_db_errors_total{service=\"dealers-drive-api\",environment=~\"$environment\"}[$__rate_interval]))",
          "legendFormat": "{{model}}.{{operation}}",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "decimals": 0 },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "title": "Slow database operations",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (model, operation) (increase(dealers_drive_db_slow_operations_total{service=\"dealers-drive-api\",environment=~\"$environment\"}[$__rate_interval]))",
          "legendFormat": "{{model}}.{{operation}}",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 9 },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "decimals": 0 },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "title": "Database p50 / p95 / p99",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le, model, operation) (rate(dealers_drive_db_operation_duration_seconds_bucket{service=\"dealers-drive-api\",environment=~\"$environment\"}[$__rate_interval])))",
          "legendFormat": "p50 · {{model}}.{{operation}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, model, operation) (rate(dealers_drive_db_operation_duration_seconds_bucket{service=\"dealers-drive-api\",environment=~\"$environment\"}[$__rate_interval])))",
          "legendFormat": "p95 · {{model}}.{{operation}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, model, operation) (rate(dealers_drive_db_operation_duration_seconds_bucket{service=\"dealers-drive-api\",environment=~\"$environment\"}[$__rate_interval])))",
          "legendFormat": "p99 · {{model}}.{{operation}}",
          "refId": "C"
        }
      ],
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 9 },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "s" },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "title": "Request time vs attributed DB time",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (method, route) (rate(dealers_drive_http_request_duration_seconds_sum{service=\"dealers-drive-api\",environment=~\"$environment\"}[$__rate_interval])) / clamp_min(sum by (method, route) (rate(dealers_drive_http_request_duration_seconds_count{service=\"dealers-drive-api\",environment=~\"$environment\"}[$__rate_interval])), 0.001)",
          "legendFormat": "request · {{method}} {{route}}",
          "refId": "A"
        },
        {
          "expr": "sum by (method, route) (rate(dealers_drive_http_request_db_duration_seconds_sum{service=\"dealers-drive-api\",environment=~\"$environment\"}[$__rate_interval])) / clamp_min(sum by (method, route) (rate(dealers_drive_http_request_db_duration_seconds_count{service=\"dealers-drive-api\",environment=~\"$environment\"}[$__rate_interval])), 0.001)",
          "legendFormat": "database · {{method}} {{route}}",
          "refId": "B"
        }
      ],
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 18 },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "s" },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "title": "Database operations per request",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (method, route) (rate(dealers_drive_http_request_db_operations_sum{service=\"dealers-drive-api\",environment=~\"$environment\"}[$__rate_interval])) / clamp_min(sum by (method, route) (rate(dealers_drive_http_request_db_operations_count{service=\"dealers-drive-api\",environment=~\"$environment\"}[$__rate_interval])), 0.001)",
          "legendFormat": "{{method}} {{route}}",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 18 },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["dealers-drive", "observability"],
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(dealers_drive_http_requests_total{service=\"dealers-drive-api\"}, environment)",
        "query": {
          "query": "label_values(dealers_drive_http_requests_total{service=\"dealers-drive-api\"}, environment)",
          "refId": "environment"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "current": { "text": "production", "value": "production" }
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Dealers Drive / Database Performance",
  "uid": "dealers-drive-database-performance",
  "version": 1,
  "weekStart": ""
}
