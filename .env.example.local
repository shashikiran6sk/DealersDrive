NODE_ENV=development
APP_ENV=local
GIT_SHA=unknown
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=debug
METRICS_ENABLED=false
DB_SLOW_OPERATION_MS=500
GRAFANA_CLOUD_LOGS_ENABLED=false
GRAFANA_CLOUD_LOKI_URL=
WEB_ORIGIN=http://localhost:3000
WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
DB_TRANSACTION_TIMEOUT_MS=20000
DB_TRANSACTION_MAX_WAIT_MS=10000
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000
AUTH_MODE=cookie
DEV_DEALER_SLUG=sri-lakshmi-automobiles-pvt-ltd-vellore-tamil-nadu
ADMIN_ALLOWLIST=admin@example.com
GOOGLE_CALLBACK_URL=http://localhost:4000/v1/auth/google/callback
SESSION_COOKIE_DOMAIN=
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=dealers-drive
S3_FORCE_PATH_STYLE=true
MEDIA_BASE_URL=http://localhost:4000/media
MAIL_DRIVER=console
MAIL_FROM="Dealers-Drive Local <updates@localhost>"
PHONE_OTP_DRIVER=fake
PHONE_OTP_TIMEOUT_MS=4000
PHONE_OTP_DEV_CODE=123456
SUPPORT_EMAIL=support@example.com
SUPPORT_PHONE=+919876543210
WORKER_INLINE=true
JOBS_ENABLED=true
RATE_LIMIT_ENABLED=true
CLIENT_IP_FORWARD_SECRET=
CACHE_DRIVER=memory
CONFIG_VERSION_POLL_MS=10000
SHUTDOWN_DRAIN_MS=0
SHUTDOWN_TIMEOUT_MS=15000
DOCS_ENABLED=true

DATABASE_URL=postgresql://dealersdrive:dealersdrive@localhost:5432/dealersdrive
SESSION_SECRET=dealers-drive-local-session-secret
UPLOAD_SIGNING_SECRET=dealers-drive-local-upload-secret
METRICS_SCRAPE_TOKEN=

GRAFANA_CLOUD_LOKI_USER=
GRAFANA_CLOUD_LOKI_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
RESEND_API_KEY=
MSG91_AUTH_KEY=
MSG91_WIDGET_ID=
MSG91_WIDGET_TOKEN=

# White-label websites stay disabled until owner-reviewed hosting/DNS/TLS rollout.
STOREFRONT_ENABLED=false
STOREFRONT_DEFAULT_DOMAIN_READY=false
STOREFRONT_ROOT_HOSTNAME=dealers-drive.com
# Same random server-only secret on API and storefront; at least 32 characters.
STOREFRONT_SERVICE_SECRET=
# Provider credentials belong only on API/worker, never in browser variables.
STOREFRONT_DOMAIN_PROVIDER=disabled
STOREFRONT_VERCEL_TOKEN=
STOREFRONT_VERCEL_PROJECT_ID=
STOREFRONT_VERCEL_TEAM_ID=
